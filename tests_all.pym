# @@MODULE tests_v57_upstox_nvidia
"""v57 regression tests: Upstox failure handling (retry / reuse last good data / visible reason) and NVIDIA model selection."""
import sys, types, unittest, os
for _m in ("feedparser", "streamlit", "yfinance", "upstox_client", "supabase", "plotly"):
    try:
        __import__(_m)
    except Exception:
        sys.modules[_m] = types.ModuleType(_m)
try:
    import xgboost  # noqa: F401
except Exception:
    _xgb = types.ModuleType("xgboost"); _xgb.XGBClassifier = object; sys.modules["xgboost"] = _xgb
import pandas as pd
import market_data
import nvidia_llm


class _Resp:
    def __init__(self, code, body):
        self.status_code, self._b = code, body
    def json(self):
        return self._b


class UpstoxHandlingTests(unittest.TestCase):
    def setUp(self):
        self._orig = market_data.requests.get
        self._sleep = market_data.time.sleep
        market_data.time.sleep = lambda s: None

    def tearDown(self):
        market_data.requests.get = self._orig
        market_data.time.sleep = self._sleep

    def test_429_is_not_retried_and_cache_saves_calls(self):
        calls = []
        def fake(url, headers=None, timeout=None):
            calls.append(url)
            return _Resp(200, {"status": "success", "data": {"candles": [["2026-11-02T09:15:00+05:30", 1, 2, 0.5, 1.5, 0, 0]]}})
        market_data.requests.get = fake
        market_data._CACHE.clear()
        market_data._fetch_upstox_candles("tok", instrument_key="K|1")
        n1 = len(calls)
        market_data._fetch_upstox_candles("tok", instrument_key="K|1")      # second tab / next refresh within TTL -> no new Upstox calls
        self.assertEqual(n1, 2)
        self.assertEqual(len(calls), n1)
        calls.clear(); market_data._CACHE.clear()
        market_data.requests.get = lambda *a, **k: (calls.append(1), _Resp(429, {}))[1]
        self.assertIsNone(market_data._fetch_upstox_ltp("tok"))
        self.assertEqual(len(calls), 1)                                       # exactly one attempt: no retry storm, no sleep

    def test_failure_reason_is_recorded(self):
        market_data._CACHE.clear()
        market_data.requests.get = lambda *a, **k: _Resp(400, {"status": "error", "errors": [{"message": "Invalid Instrument key"}]})
        self.assertIsNone(market_data._fetch_upstox_ltp("tok"))
        self.assertIn("Invalid Instrument key", market_data.last_upstox_error())


class NvidiaFastFallbackTests(unittest.TestCase):
    def test_thinking_timeout_falls_back_to_fast_mode_same_model(self):
        import json as _j
        calls = []
        class Resp:
            status_code = 200
            def __init__(self, lines): self._l = lines
            def iter_lines(self, decode_unicode=True): return iter(self._l)
            def close(self): pass
        def fake_post(url, headers=None, json=None, stream=None, timeout=None):
            calls.append(json["chat_template_kwargs"]["enable_thinking"])
            if json["chat_template_kwargs"]["enable_thinking"]:
                raise TimeoutError("slow thinking")
            return Resp(["data: " + _j.dumps({"choices": [{"delta": {"content": "FAST ANSWER"}}]}), "data: [DONE]"])
        orig = nvidia_llm.requests.post
        nvidia_llm.requests.post = fake_post
        nvidia_llm._STATE.update(models=["nvidia/nemotron-3-ultra-550b-a55b"], ts=nvidia_llm.time.time(), cool={}, dead={})
        try:
            txt, model = nvidia_llm.chat(["k" * 12], [{"role": "user", "content": "hi"}], thinking=True, deadline_s=100.0, post=fake_post)
        finally:
            nvidia_llm.requests.post = orig
        self.assertEqual(txt, "FAST ANSWER")
        self.assertEqual(calls, [True, False])
        self.assertIn("nemotron-3-ultra", model)


class NvidiaNextModelTests(unittest.TestCase):
    def test_next_model_answers_when_first_is_slow(self):
        import json as _j
        class Resp:
            status_code = 200
            def __init__(self, lines): self._l = lines
            def iter_lines(self, decode_unicode=True): return iter(self._l)
            def close(self): pass
        seen = []
        def fake_post(url, headers=None, json=None, stream=None, timeout=None):
            seen.append(json["model"])
            if "nemotron" in json["model"]:
                raise TimeoutError("slow")
            return Resp(["data: " + _j.dumps({"choices": [{"delta": {"content": "DEEPSEEK ANSWER"}}]}), "data: [DONE]"])
        orig = nvidia_llm.requests.post
        nvidia_llm.requests.post = fake_post
        nvidia_llm._STATE.update(models=["nvidia/nemotron-3-ultra-550b-a55b", "deepseek-ai/deepseek-v3.1"], ts=nvidia_llm.time.time(), cool={}, dead={})
        try:
            txt, model = nvidia_llm.chat(["k" * 12], [{"role": "user", "content": "hi"}], thinking=True, deadline_s=100.0, post=fake_post)
        finally:
            nvidia_llm.requests.post = orig
        self.assertEqual(txt, "DEEPSEEK ANSWER")
        self.assertEqual(model, "deepseek-ai/deepseek-v3.1")


class NvidiaModelListTests(unittest.TestCase):
    def test_junk_models_are_not_tried(self):
