"""
tests_v55_live_dom.py -- v55: aligned live-dominant trend entries are judged by their OWN record; edge-blocked setups are shadow-tracked per gate.
Run:  python -m unittest tests_v55_live_dom -v
"""
import json, os, sqlite3, sys, unittest
from datetime import datetime, timedelta

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from tests_edge_v36 import DbCase, _decide, _flags  # noqa: E402
from tests_v42_momentum_tick import _strong  # noqa: E402
import ai_trade_decision as atd
import trade_learning as tl
import shadow_trades as sh


def _history(n, win_every, live_dom, side="BUY"):
    c = sqlite3.connect(tl.DB_NAME)
    for i in range(n):
        fj = json.dumps(_flags(10, **{"_entry_meta": {"logic_version": tl.LOGIC_VERSION, "side": side},
                                      "_features": {"is_buy": 1.0 if side == "BUY" else 0.0},
                                      "live_dom_entry": bool(live_dom), "entry_not_extended": True}))
        c.execute("INSERT INTO ai_trade_setups (timestamp,direction,strike,option_type,underlying_entry,stop_loss,target,"
                  "confidence_pct,factors_json,status) VALUES ('2026-01-01 10:00:00',?,1,'CE',1,1,1,1,?,?)",
                  (side, fj, "WIN" if (win_every and i % win_every == 0) else "LOSS"))
    c.commit(); c.close()


class LiveDomEntry(DbCase):
    def test_flag_is_set_and_old_losing_record_does_not_block(self):
        _history(40, 8, live_dom=False)                  # 12 % record of ordinary BUYs
        out = _decide("BUY", strategy=_strong("BUY", live=80, cons=95, n=5))
        self.assertTrue(out.get("live_dom_entry"), out.get("reason"))
        self.assertTrue(out["has_setup"], out.get("reason"))

    def test_kill_switch_restores_v54(self):
        _history(40, 8, live_dom=False)
        atd.LIVE_DOM_ENTRIES = False
        try:
            out = _decide("BUY", strategy=_strong("BUY", live=80, cons=95, n=5))
        finally:
            atd.LIVE_DOM_ENTRIES = True
        self.assertFalse(out["has_setup"]); self.assertIn("No positive edge", out["reason"])

    def test_own_losing_record_stops_it(self):
        _history(40, 8, live_dom=True)                   # 40 live-dominant trades, 12 % wins
        out = _decide("BUY", strategy=_strong("BUY", live=80, cons=95, n=5))
        self.assertFalse(out["has_setup"], out.get("reason"))
        self.assertIn("No positive edge", out["reason"])

    def test_not_live_dominant_is_unchanged(self):
        _history(40, 8, live_dom=False)
        out = _decide("BUY", strategy=_strong("BUY", live=20, cons=40, n=1))
        self.assertFalse(out.get("live_dom_entry"))
        self.assertFalse(out["has_setup"])


class ShadowQuota(DbCase):
    def _cand(self, d="BUY"):
        return {"direction": d, "underlying_entry": 100.0, "stop_loss": 90.0, "target": 120.0, "factor_flags": {}}

    def test_each_gate_gets_its_own_budget(self):
        now = datetime(2026, 10, 29, 10, 30)
        self.assertIsNotNone(sh.log(self._cand(), "S/R location / confirmation", now=now))
        # same direction, same minute, different gate -> still logged (was starved before v55)
        self.assertIsNotNone(sh.log(self._cand(), "No positive edge (EV)", now=now + timedelta(minutes=1)))
        # same gate again too soon -> deduped
        self.assertIsNone(sh.log(self._cand(), "No positive edge (EV)", now=now + timedelta(minutes=2)))


if __name__ == "__main__":
    unittest.main()


class ReviewWaitAndEvidence(DbCase):
    def test_fast_review_returns_in_the_same_refresh(self):
        import time
        atd._REVIEW_JOBS.clear()
        orig = atd.gemini_trade_review
        atd.gemini_trade_review = lambda *a, **k: (time.sleep(0.6), {"status": "APPROVED", "approved": True})[1]
        try:
            r = atd.gemini_review_async(("c55", "BUY"), ["k"], {}, {}, "BUY")
        finally:
            atd.gemini_trade_review = orig; atd._REVIEW_JOBS.clear()
        self.assertEqual(r["status"], "APPROVED")             # was PENDING for a whole 30 s refresh before v55b

    def _shadow(self, n, win_every, gate="No positive edge (EV)", wins_of_10=None):
        c = sqlite3.connect(tl.DB_NAME)
        sh._local_init()
        for i in range(n):
            c.execute("INSERT INTO ai_shadow_setups (timestamp,direction,underlying_entry,stop_loss,target,blocked_by,factors_json,status) "
                      "VALUES ('2026-01-01 10:00:00','BUY',100,90,120,?,?,?)",
                      (gate, json.dumps(_flags(10)), "WIN" if ((i % 10 < wins_of_10) if wins_of_10 is not None else (i % win_every == 0)) else "LOSS"))
        c.commit(); c.close()

    def test_edge_gate_record_counts_legacy_label(self):
        self._shadow(20, 2, "S/R location / confirmation"); self._shadow(20, 2)
        r = sh.edge_gate_record()
        self.assertEqual(r["n"], 40); self.assertAlmostEqual(r["win_rate"], 0.5)

    def test_gate_stands_aside_only_while_its_refusals_win(self):
        _history(40, 8, live_dom=False)
        self._shadow(50, 2, wins_of_10=6)                     # refused setups win 60 % (n=50)
        # v59: this fixture's setup is a ~17 % win-chance one; the sanity floor (tested below) refuses that, so the MECHANISM is tested with the floor lowered
        _p, _e = atd.EVIDENCE_MIN_PROB, atd.EVIDENCE_MIN_EV_R
        atd.EVIDENCE_MIN_PROB, atd.EVIDENCE_MIN_EV_R = 0.0, -9.0
        try:
            out = _decide("BUY", strategy=_strong("BUY", live=20, cons=40, n=1))   # NOT live-dominant: v55 lane does not apply
        finally:
            atd.EVIDENCE_MIN_PROB, atd.EVIDENCE_MIN_EV_R = _p, _e
        self.assertTrue(out["has_setup"], out.get("reason"))
        self.assertTrue(out["factor_flags"].get("evidence_relief"))

    def test_v59_sanity_floor_keeps_garbage_out_even_when_refusals_win(self):
        _history(40, 8, live_dom=False)
        self._shadow(50, 2, wins_of_10=6)
        out = _decide("BUY", strategy=_strong("BUY", live=20, cons=40, n=1))   # ~17 % win chance, -0.58R
        self.assertFalse(out["has_setup"]); self.assertIn("No positive edge", out["reason"]); self.assertIn("sanity floor", out["reason"])

    def test_v59_two_nov_record_passes_the_relief_test(self):
        # 2-Nov dashboard: refused setups won 48 of 101 (47.5 %); break-even at R:R 1.5 is 40 %.
        c = sqlite3.connect(tl.DB_NAME)
        sh._local_init()
        for k in range(101):
            c.execute("INSERT INTO ai_shadow_setups (timestamp,direction,underlying_entry,stop_loss,target,blocked_by,factors_json,status) "
                      "VALUES ('2026-01-01 10:00:00','BUY',100,90,120,?,?,?)",
                      ("S/R location / confirmation" if k % 2 else "No positive edge (EV)", json.dumps(_flags(10)), "WIN" if k < 48 else "LOSS"))
        c.commit(); c.close()
        old = sh.edge_gate_record(z=1.645); new = sh.edge_gate_record(z=atd.EVIDENCE_Z)
        self.assertEqual((old["n"], old["wins"]), (101, 48))
        self.assertLess(old["wilson_low"], 0.40 + 0.02)                                # v58 test: relief never switched on
        self.assertGreaterEqual(new["wilson_low"], 0.40 + atd.EVIDENCE_MARGIN)          # v59: it does

    def test_losing_refusals_keep_the_gate(self):
        _history(40, 8, live_dom=False)
        self._shadow(40, 8)                                   # refused setups win 12 % -> the gate was right
        out = _decide("BUY", strategy=_strong("BUY", live=20, cons=40, n=1))
        self.assertFalse(out["has_setup"]); self.assertIn("No positive edge", out["reason"])

    def test_kill_switch(self):
        _history(40, 8, live_dom=False); self._shadow(50, 2, wins_of_10=6)
        atd.EVIDENCE_RELIEF = False
        try:
            out = _decide("BUY", strategy=_strong("BUY", live=20, cons=40, n=1))
        finally:
            atd.EVIDENCE_RELIEF = True
        self.assertFalse(out["has_setup"])
# @@END tests_v55_live_dom
# @@MODULE tests_v55_missed_moves
import os, sys, tempfile, unittest
from datetime import datetime, timedelta
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import gate_log


class MissedMoves(unittest.TestCase):
    def setUp(self):
        self.d = tempfile.mkdtemp(); gate_log.DB_PATH = os.path.join(self.d, "g.db")

    def test_rally_without_trade_names_the_blocking_gate(self):
        t0 = datetime(2026, 10, 28, 10, 25)
        for i in range(10):
            gate_log.record((t0 + timedelta(minutes=5 * i)).strftime("%Y-%m-%d %H:%M:%S"), 22520 + 25 * i,
                            "No positive edge (EV)", direction="BUY")
        m = gate_log.missed_moves("2026-10-28")
        self.assertEqual(len(m), 1); self.assertEqual(m[0]["dir"], "BUY"); self.assertFalse(m[0]["taken"])
        self.assertEqual(m[0]["gates"][0][0], "No positive edge (EV)")

    def test_traded_move_and_small_move(self):
        t0 = datetime(2026, 10, 28, 10, 25)
        for i in range(10):
            gate_log.record((t0 + timedelta(minutes=5 * i)).strftime("%Y-%m-%d %H:%M:%S"), 22520 + 25 * i,
                            "TRADE TAKEN" if i == 1 else "x", direction="BUY")
        self.assertTrue(gate_log.missed_moves("2026-10-28")[0]["taken"])
        self.assertEqual(gate_log.missed_moves("2026-10-28", min_pts=500), [])


if __name__ == "__main__":
    unittest.main()
# @@END tests_v55_missed_moves
# @@MODULE tests_v56_nvidia_news_telegram
"""
tests_v56_nvidia_news_telegram.py -- v56: NVIDIA chat model, Google News RSS research fallback, Telegram entry/exit messages.
Run:  python -m unittest tests_v56_nvidia_news_telegram -v
"""
import os, sys, unittest
from datetime import datetime, timedelta, timezone

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from tests_edge_v36 import DbCase  # noqa: E402  (installs the import stubs)
import nvidia_llm as nv
import news_rss
import trade_notify as tn
import trade_learning as tl


class _R:
    def __init__(self, code, body=None):
        self.status_code, self._b = code, body or {}
    def json(self):
        return self._b


def _ok(text):
    return _R(200, {"choices": [{"message": {"content": text}}]})


class Nvidia(unittest.TestCase):
    def setUp(self):
        nv._STATE.update({"models": None, "ts": 0.0, "cool": {}, "dead": {}, "last_model": None, "last_error": ""})

    def test_keys_and_think_removal(self):
        self.assertEqual(nv.keys_from_secrets({"NVIDIA_API_KEY": "a", "NVIDIA_API_KEY_2": "b"}), ["a", "b"])
        self.assertEqual(nv.clean_reply("<think>plan plan</think>\n\nBUY 23000"), "BUY 23000")
        self.assertEqual(nv.clean_reply("hidden reasoning</think>Answer"), "Answer")

    def test_candidates_follow_the_live_model_list(self):
        c = nv.candidate_models(["meta/llama-3.3-70b-instruct", "x/embed-qa", "nvidia/llama-3.1-nemotron-ultra-253b-v1"])
        self.assertEqual(c[0], "nvidia/llama-3.1-nemotron-ultra-253b-v1"); self.assertNotIn("x/embed-qa", c)
        self.assertEqual(nv.candidate_models([], forced="my/model")[0], "my/model")

    def test_falls_through_429_and_dead_models(self):
        nv._STATE.update({"models": ["nvidia/llama-3.1-nemotron-ultra-253b-v1", "deepseek-ai/deepseek-v3.1", "meta/llama-3.3-70b-instruct"], "ts": 9e12})
        calls = []
        def post(url, headers=None, json=None, timeout=None):
            calls.append(json["model"])
            if json["model"].startswith("nvidia/"): return _R(404)
            if json["model"].startswith("deepseek"): return _R(429)
            return _ok("<think>x</think>jawab")
        txt, model = nv.chat(["k1"], [{"role": "user", "content": "hi"}], post=post)
        self.assertEqual((txt, model), ("jawab", "meta/llama-3.3-70b-instruct"))
        self.assertEqual(calls[0], "nvidia/llama-3.1-nemotron-ultra-253b-v1")
        self.assertGreater(nv._STATE["dead"]["nvidia/llama-3.1-nemotron-ultra-253b-v1"], 0)

    def test_nemotron_3_ultra_is_first_and_gets_thinking_settings(self):
        nv._STATE.update({"models": ["nvidia/nemotron-3-ultra-550b-a55b", "meta/llama-3.3-70b-instruct"], "ts": 9e12})
        seen = {}
        def post(url, headers=None, json=None, timeout=None):
            seen.update(json); return _ok("ok")
        self.assertEqual(nv.chat(["k"], [{"role": "user", "content": "hi"}], post=post, thinking=True)[1], "nvidia/nemotron-3-ultra-550b-a55b")
        self.assertTrue(seen["chat_template_kwargs"]["enable_thinking"]); self.assertEqual(seen["top_p"], 0.95)

    def test_unavailable_raises_for_gemini_fallback(self):
        nv._STATE.update({"models": ["meta/llama-3.3-70b-instruct"], "ts": 9e12})
        with self.assertRaises(nv.NvidiaUnavailable):
            nv.chat(["k1"], [{"role": "user", "content": "hi"}], post=lambda *a, **k: _R(500))
        with self.assertRaises(nv.NvidiaUnavailable):
            nv.chat([], [])


RSS = """<rss><channel>
<item><title>Nifty ends higher on banks - Economic Times</title><source>Economic Times</source><pubDate>{a}</pubDate></item>
<item><title>Old story - Mint</title><source>Mint</source><pubDate>{b}</pubDate></item>
</channel></rss>"""


class NewsRss(unittest.TestCase):
    def test_parse_keeps_fresh_items_and_strips_source_suffix(self):
        now = datetime(2026, 11, 1, 9, 0, tzinfo=timezone.utc)
        fmt = lambda d: d.strftime("%a, %d %b %Y %H:%M:%S GMT")
        items = news_rss.parse_items(RSS.format(a=fmt(now - timedelta(minutes=30)), b=fmt(now - timedelta(days=3))), now=now)
        self.assertEqual(len(items), 1); self.assertEqual(items[0][1], "Nifty ends higher on banks"); self.assertEqual(items[0][0], 30)

    def test_brief_builds_bullets_and_survives_fetch_errors(self):
        news_rss._CACHE.update({"ts": 0.0, "text": ""})
        now = datetime.now(timezone.utc)
        fmt = lambda d: d.strftime("%a, %d %b %Y %H:%M:%S GMT")
        n = {"i": 0}
        def fetch(q):
            n["i"] += 1
            if n["i"] == 1: raise RuntimeError("boom")
            return RSS.format(a=fmt(now - timedelta(minutes=10 * n["i"])), b=fmt(now - timedelta(days=3))).replace("higher on banks", f"q{n['i']}")
        txt = news_rss.brief(force=True, fetch=fetch)
        self.assertIn("- [FII/DII]", txt); self.assertNotIn("Old story", txt)
        news_rss._CACHE.update({"ts": 0.0, "text": ""})
        self.assertEqual(news_rss.brief(force=True, fetch=lambda q: (_ for _ in ()).throw(RuntimeError("x"))), "")


class Telegram(DbCase):
    def setUp(self):
        super().setUp()
        tn._SENT.clear()
        self.sent = []
        self._p, self._sa = tn._post, tn._send_async
        tn._send_async = lambda key, text: self.sent.append((key, text))
        tn.configure("tok", "chat")

    def tearDown(self):
        tn._post, tn._send_async = self._p, self._sa
        tn.configure(None, None)
        tl.set_exit_hook(None)
        super().tearDown()

    DEC = {"direction": "BUY", "underlying_entry": 23050.5, "stop_loss": 23025.0, "target": 23095.0, "risk_reward": 1.75, "strike": 23050,
           "option_type": "CE", "confidence_pct": 41.2, "expectancy_r": 0.13, "strategy_names": ["Classic 30-Min ORB"], "live_dom_entry": True,
           "gemini_review": {"reason": "Price <above> VWAP & EMA20"}}

    def test_entry_message_has_everything_and_is_sent_once(self):
        self.assertTrue(tn.notify_entry(7, self.DEC)); self.assertFalse(tn.notify_entry(7, self.DEC))
        text = self.sent[0][1]
        for part in ("TRADE LIYA: BUY", "23,050.50", "23,025.00", "25.5 pts", "23,095.00", "1.75", "23050 CE", "Classic 30-Min ORB", "Live-dominant", "&lt;above&gt;"):
            self.assertIn(part, text)
        self.assertEqual(len(self.sent), 1)

    def test_exit_message_for_win_loss_and_expired(self):
        row = {"id": 7, "timestamp": "2026-11-01 10:00:00", "direction": "BUY", "underlying_entry": 23050.5, "stop_loss": 23025.0, "target": 23095.0}
        self.assertTrue(tn.notify_exit(row, "WIN", 23095.0))
        self.assertIn("TARGET HIT", self.sent[0][1]); self.assertIn("+44.5 pts", self.sent[0][1])
        sell = dict(row, id=8, direction="SELL", stop_loss=23075.0, target=23000.0)
        tn.notify_exit(sell, "LOSS", 23075.0)
        self.assertIn("STOP-LOSS HIT", self.sent[1][1]); self.assertIn("-24.5 pts", self.sent[1][1])
        tn.notify_exit(dict(row, id=9), "EXPIRED", 23060.0)
        self.assertIn("TIME EXIT", self.sent[2][1])
        self.assertFalse(tn.notify_exit(row, "WIN", 23095.0))            # same trade: no duplicate

    def test_exit_message_shows_how_close_the_trade_came(self):
        import json as _j
        row = {"id": 5, "timestamp": "2026-11-01 10:00:00", "direction": "BUY", "underlying_entry": 23000.0, "stop_loss": 22972.0, "target": 23046.0,
               "factors_json": _j.dumps({"_learning_meta": {"max_favorable_pts": 23.0, "max_adverse_pts": 28.0}})}
        tn.notify_exit(row, "LOSS", 22972.0)
        self.assertIn("sabse achha +23 pts (target ka 50%)", self.sent[0][1]); self.assertIn("sabse bura -28 pts", self.sent[0][1])

    def test_not_configured_is_silent(self):
        tn.configure(None, None)
        self.assertFalse(tn.notify_entry(1, self.DEC)); self.assertEqual(self.sent, [])

    def test_failed_send_is_retried_later(self):
        tn._send_async = self._sa
        calls = []
        tn._post = lambda text: (calls.append(1), False)[1]
        tn.notify_entry(11, self.DEC)
        import time; time.sleep(0.3)
        self.assertNotIn("entry:11", tn._SENT)                           # claim released -> next refresh tries again

    def test_resolver_fires_the_exit_hook(self):
        tl.set_exit_hook(tn.notify_exit)
        sid = tl.log_setup("BUY", 23050, "CE", 23050.0, 23025.0, 23095.0, 40.0, {"a": True})
        self.assertTrue(sid)
        self.assertEqual(tl.resolve_tick(23096.0), 1)
        self.assertTrue(any(k.startswith("exit:") and "TARGET HIT" in t for k, t in self.sent), self.sent)


