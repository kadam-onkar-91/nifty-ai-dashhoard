"""v58 regression tests: strong-tape relief for the full-context confluence gate, and NVIDIA never saying "no model available" while it rests."""
import os, sys, unittest

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from tests_edge_v36 import DbCase  # noqa: E402
from tests_v42_momentum_tick import _strong  # noqa: E402
from tests_v54_reaction import _decide_conflicting  # noqa: E402
import ai_trade_decision as atd  # noqa: E402
import nvidia_llm as nv  # noqa: E402


class StrongTapeRelief(DbCase):
    def test_sell_with_strong_down_tape_and_one_live_strategy_is_not_vetoed_by_lagging_reads(self):
        # 2-Nov-2026 11:41: live tape -46, one live SELL strategy (59 %), regime + MTF still bullish -> used to be "4 confirmations; 2 conflicts"
        out = _decide_conflicting("SELL", _strong("SELL", live=46, cons=59, n=1))
        self.assertNotIn("confluence is not strong", out.get("reason", ""), out.get("reason"))

    def test_weak_tape_still_vetoed(self):
        out = _decide_conflicting("SELL", _strong("SELL", live=20, cons=40, n=1))
        self.assertFalse(out["has_setup"]); self.assertIn("confluence is not strong", out["reason"])

    def test_kill_switch(self):
        atd.TAPE_RELIEF = False
        try:
            out = _decide_conflicting("SELL", _strong("SELL", live=46, cons=59, n=1))
        finally:
            atd.TAPE_RELIEF = True
        self.assertFalse(out["has_setup"]); self.assertIn("confluence is not strong", out["reason"])


class NvidiaNeverStuck(unittest.TestCase):
    def test_all_models_resting_are_revived_and_answer(self):
        import time
        models = ["nvidia/nemotron-3-ultra-550b-a55b", "deepseek-ai/deepseek-v3.1"]
        far = time.time() + 99999
        nv._STATE.update(models=models, ts=time.time(), cool={("kkkkkk", m): far for m in models}, dead={m: far for m in models})

        class _R:
            status_code = 200
            def json(self): return {"choices": [{"message": {"content": "ok jawab"}}]}

        txt, model = nv.chat(["k" * 12], [{"role": "user", "content": "hi"}], post=lambda *a, **k: _R())
        self.assertEqual(txt, "ok jawab")

    def test_error_text_is_never_the_empty_no_model_available(self):
        import time
        nv._STATE.update(models=["nvidia/nemotron-3-ultra-550b-a55b"], ts=time.time(), cool={}, dead={})

        class _R:
            status_code = 500
        with self.assertRaises(nv.NvidiaUnavailable) as cm:
            nv.chat(["k" * 12], [{"role": "user", "content": "hi"}], post=lambda *a, **k: _R())
        self.assertNotEqual(str(cm.exception), "no model available")
        self.assertIn("HTTP 500", str(cm.exception))


if __name__ == "__main__":
    unittest.main()
# @@END tests_v58_gate_nvidia

# @@MODULE tests_v59_gates
"""v59 regression tests: 'entry too far from level' is a probability cost (not a wall) for strategy-led trend entries, and stays a wall far away."""
import os, sys, unittest
from datetime import datetime

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from tests_edge_v36 import DbCase  # noqa: E402
from tests_v42_momentum_tick import _strong  # noqa: E402
import ai_trade_decision as atd  # noqa: E402


def _decide_far(direction, gap, atr=14.0, live=24000.0, strategy=None):
    """A strategy-led entry whose S/R level sits `gap` points away from price (all other evidence aligned)."""
    bull = direction == "BUY"
    sr = {"status": "OK", "location": "AT_SUPPORT" if bull else "AT_RESISTANCE",
          "confirmation": {"support_rejection_confirmed": True, "resistance_rejection_confirmed": True}, "entry_timing": {},
          "major_support": {"price": live - 2, "low": live - 6, "high": live - 1, "sources": ["PDL"]},
          "major_resistance": {"price": live + 2, "low": live + 1, "high": live + 6, "sources": ["PDH"]}}
    ctx = {"Data Freshness": "Live / fresh", "RAW Regime Engine": "BULLISH" if bull else "BEARISH",
           "RAW Multi-Timeframe Structure": "bullish bullish bullish" if bull else "bearish bearish bearish",
           "RAW Order Flow": {"pressure": "BUYING PRESSURE" if bull else "SELLING PRESSURE"}}
    lp = {"status": "APPROACHING_LEVEL", "approaching": "support" if bull else "resistance",
          "level_price": live - gap if bull else live + gap, "distance_pts": gap, "break_pct": 70, "bounce_pct": 72,
          "directional_bias": "Bullish" if bull else "Bearish",
          "factors": ["Heavy Put OI" if bull else "Heavy Call OI", "above a rising VWAP" if bull else "below a falling VWAP"]}
    import macro_confluence as _mc
    _old = _mc.ENABLED; _mc.ENABLED = False
    try:
        return atd.generate_trade_decision(
            live_price=live, level_prediction=lp, atr=atr, max_pain=23900 if bull else 24100, signal_code=1 if bull else -1, ml_agrees=True,
            breadth_advances=35 if bull else 12, breadth_declines=15 if bull else 38, global_avg_change=0.4 if bull else -0.4, live_vix=13.0,
            india_news_sentiment="BULLISH" if bull else "BEARISH", level_ladder=None, sr_context=sr, sniper_bias="BULLISH" if bull else "BEARISH",
            dashboard_context=ctx, nifty50_news_sentiment="BULLISH" if bull else "BEARISH", nifty50_fundamentals_bias="NEUTRAL",
            strategy_result=strategy or _strong(direction, live=50, cons=90, n=3), now_ist=datetime(2026, 10, 5, 11, 0))
    finally:
        _mc.ENABLED = _old


class FarFromLevelIsACost(DbCase):
    def test_slightly_far_entry_is_taken_with_lower_probability(self):
        near = _decide_far("BUY", gap=3.0)
        far = _decide_far("BUY", gap=15.0)               # soft limit = max(0.9 ATR, 10) = 12.6 pts (breakout side) -> 15 is over it, under 1.8 ATR = 25
        self.assertNotIn("too far", far.get("reason", ""), far.get("reason"))
        if far.get("has_setup") and near.get("has_setup"):
            self.assertLess(far["win_probability"], near["win_probability"])
            self.assertTrue(any("probability reduced" in str(x) for x in far["soft_flags"]))

    def test_very_far_entry_is_still_refused(self):
        out = _decide_far("BUY", gap=40.0)
        self.assertFalse(out["has_setup"]); self.assertIn("too far from the validated level", out["reason"])
        self.assertEqual(atd.classify_block(out["reason"]), "Entry too far from level")

    def test_kill_switch_restores_v58(self):
        atd.FAR_LEVEL_SOFT = False
        try:
            out = _decide_far("BUY", gap=15.0)
        finally:
            atd.FAR_LEVEL_SOFT = True
        self.assertFalse(out["has_setup"]); self.assertIn("too far from the validated level", out["reason"])


if __name__ == "__main__":
    unittest.main()
# @@END tests_v59_gates

# @@MODULE tests_v61_speed
"""v61 speed tests: futures-key cache, single-flight Upstox cache, background ML, robot standby bookkeeping, watchlist busy-set, robot keeper."""
import sys, types, unittest, threading, time
for _m in ("feedparser", "streamlit", "yfinance", "upstox_client", "supabase", "plotly"):
    try:
        __import__(_m)
    except Exception:
        sys.modules[_m] = types.ModuleType(_m)
import pandas as pd
import market_data
import ml_engine
import safe_io


class FuturesKeyCacheTests(unittest.TestCase):
    def setUp(self):
        self._orig = market_data._resolve_upstox_nifty_future_key
        market_data._FUT_KEY.update(key=None, debug="x", ts=0.0, fail_ts=0.0, expiry=None)
        self.calls = []

    def tearDown(self):
        market_data._resolve_upstox_nifty_future_key = self._orig

    def test_downloaded_once_not_on_every_call(self):
        def fake():
            self.calls.append(1)
            market_data._FUT_KEY_EXPIRY["v"] = pd.Timestamp.now().normalize() + pd.Timedelta(days=10)
            return "NSE_FO|123", "OK"
        market_data._resolve_upstox_nifty_future_key = fake
        for _ in range(6):
            self.assertEqual(market_data._load_upstox_nifty_future_key()[0], "NSE_FO|123")
        self.assertEqual(len(self.calls), 1)
        self.assertEqual(market_data.get_nifty_futures_instrument_key(), "NSE_FO|123")

    def test_failure_backs_off_for_a_while(self):
        market_data._resolve_upstox_nifty_future_key = lambda: (self.calls.append(1), (None, "boom"))[1]
        for _ in range(4):
            self.assertIsNone(market_data._load_upstox_nifty_future_key()[0])
        self.assertEqual(len(self.calls), 1)

    def test_expired_contract_is_looked_up_again(self):
        def fake():
            self.calls.append(1)
            market_data._FUT_KEY_EXPIRY["v"] = pd.Timestamp.now().normalize() - pd.Timedelta(days=1)    # already expired
            return "OLD", "OK"
        market_data._resolve_upstox_nifty_future_key = fake
        market_data._load_upstox_nifty_future_key()
        market_data._load_upstox_nifty_future_key()
        self.assertEqual(len(self.calls), 2)


class SingleFlightTests(unittest.TestCase):
    def test_two_tabs_one_upstox_call(self):
        market_data._CACHE.clear()
        calls = []

        def loader():
            calls.append(1)
            time.sleep(0.3)
            return [1, 2, 3]
        out = []
        ts = [threading.Thread(target=lambda: out.append(market_data._cached(("sf", 1), 10, 60, loader))) for _ in range(4)]
        [t.start() for t in ts]; [t.join() for t in ts]
        self.assertEqual(len(calls), 1)
        self.assertEqual(out, [[1, 2, 3]] * 4)

    def test_failed_load_serves_stale_copy(self):
        market_data._CACHE.clear()
        market_data._cached(("sf2", 1), 0, 60, lambda: [9])
        self.assertEqual(market_data._cached(("sf2", 1), 0, 60, lambda: None), [9])

    def test_no_xgboost_training_any_more(self):
        self.assertFalse(hasattr(market_data, "XGBClassifier"))


class BackgroundMlTests(unittest.TestCase):
    def setUp(self):
        self._impl = ml_engine._train_and_backtest_impl
        self._cold = ml_engine.ML_COLD_WAIT_S
        ml_engine._ML_CACHE.update(key=None, ts=0.0, result=None)
        ml_engine._ML_JOB.update(fut=None, key=None)
        self.n = 0

    def tearDown(self):
        ml_engine._train_and_backtest_impl = self._impl
        ml_engine.ML_COLD_WAIT_S = self._cold

    def _df(self, last="2026-11-11 10:00"):
        idx = pd.to_datetime([last])
        return pd.DataFrame({"Close": [1.0]}, index=idx)

    def test_cold_start_does_not_block_page(self):
        def slow(df, live_vix=None):
            self.n += 1
            time.sleep(0.6)
            return {"model_ready": True, "latest_signal": 1}
        ml_engine._train_and_backtest_impl = slow
        ml_engine.ML_COLD_WAIT_S = 0.1
        t0 = time.time()
        r = ml_engine.train_and_backtest(self._df())
        self.assertLess(time.time() - t0, 0.5)
        self.assertFalse(r["model_ready"])                       # "warming up" -- a state the engine already handles
        time.sleep(0.9)
        self.assertTrue(ml_engine.train_and_backtest(self._df())["model_ready"])
        self.assertEqual(self.n, 1)                              # the page joined the same single-flight job: trained once

    def test_new_candle_serves_previous_result_instantly(self):
        def fast(df, live_vix=None):
            self.n += 1
            time.sleep(0.4 if self.n > 1 else 0.0)
            return {"model_ready": True, "latest_signal": self.n}
        ml_engine._train_and_backtest_impl = fast
        ml_engine.ML_COLD_WAIT_S = 3.0
        first = ml_engine.train_and_backtest(self._df("2026-11-11 10:00"))
        self.assertEqual(first["latest_signal"], 1)
        t0 = time.time()
        second = ml_engine.train_and_backtest(self._df("2026-11-11 10:05"))   # new candle -> background job, old result now
        self.assertLess(time.time() - t0, 0.3)
        self.assertEqual(second["latest_signal"], 1)
        time.sleep(0.7)
        self.assertEqual(ml_engine.train_and_backtest(self._df("2026-11-11 10:05"))["latest_signal"], 2)

    def test_blocking_flag_trains_inline_for_stock_engines(self):
        ml_engine._train_and_backtest_impl = lambda df, live_vix=None: (setattr(self, "n", self.n + 1), {"model_ready": True})[1]
        self.assertTrue(ml_engine.train_and_backtest(self._df(), 15.0, blocking=True)["model_ready"])
        ml_engine.train_and_backtest(self._df(), 15.2, blocking=True)             # VIX is not part of the key any more
        self.assertEqual(self.n, 1)


class HumanVsRobotTests(unittest.TestCase):
    def setUp(self):
        safe_io._SESS.update(human_start=0.0, human_done=0.0, robot_done=0.0)

    def test_robot_idles_only_while_a_person_is_running_the_engine(self):
        self.assertFalse(safe_io.human_active())
        safe_io.run_started(False)
        self.assertTrue(safe_io.human_active())                  # a human run is in progress
        safe_io.run_aborted(False)
        self.assertFalse(safe_io.human_active())                 # interrupted / crashed -> not "active"
        safe_io.run_started(False); safe_io.run_completed(False); safe_io.run_aborted(False)
        self.assertTrue(safe_io.human_active())                  # finished a moment ago
        safe_io._SESS["human_done"] = time.time() - 1000
        self.assertFalse(safe_io.human_active())                 # tab gone for a long time -> the robot takes over

    def test_robot_runs_never_make_the_robot_idle(self):
        safe_io.run_started(True); safe_io.run_completed(True); safe_io.run_aborted(True)
        self.assertFalse(safe_io.human_active())

    def test_stuck_run_does_not_idle_the_robot_for_ever(self):
        safe_io._SESS["human_start"] = time.time() - 700
        self.assertFalse(safe_io.human_active())

    def test_once(self):
        self.assertTrue(safe_io.once("v61-test-once"))
        self.assertFalse(safe_io.once("v61-test-once"))


class WatchlistBusyTests(unittest.TestCase):
    def test_busy_is_a_set_of_refreshes(self):
        import stock_watchlist as w
        w._PAGE_BUSY.clear()
        w.page_busy(True)
        done = threading.Event()

        def other():
            w.page_busy(True); w.page_busy(False); done.set()    # the OTHER tab finishes first ...
        threading.Thread(target=other).start(); done.wait(2)
        self.assertTrue(w._page_is_busy())                       # ... but this tab is still running -> still busy (the old single flag said "idle")
        w.page_busy(False)
        self.assertFalse(w._page_is_busy())

    def test_throttle_constants(self):
        import stock_watchlist as w
        self.assertGreaterEqual(w.CYCLE_GAP, 60)


def _keeper():
    import os, bundle_loader
    here = os.path.dirname(os.path.abspath(bundle_loader.__file__))
    if here not in sys.path:
        sys.path.insert(0, here)
    import keep_open
    return keep_open


class RobotKeeperTests(unittest.TestCase):
    def test_robot_flag_added_once(self):
        k = _keeper()
        self.assertEqual(k.add_robot_flag("https://a.streamlit.app"), "https://a.streamlit.app?robot=1")
        self.assertEqual(k.add_robot_flag("https://a.streamlit.app/?x=1"), "https://a.streamlit.app/?x=1&robot=1")
        self.assertEqual(k.add_robot_flag("https://a.streamlit.app/?robot=1"), "https://a.streamlit.app/?robot=1")

    def test_standby_heartbeat_is_readable_by_the_keeper(self):
        k = _keeper()
        from datetime import datetime, timezone, timedelta
        now = datetime(2026, 11, 11, 14, 20, 0, tzinfo=timezone(timedelta(hours=5, minutes=30)))
        body = "🤖 Robot tab STANDBY -- Market OPEN -- Live Data | IST Time: 11-Nov-2026 14:19:10 -- engine abhi aapke apne tab mein chal raha hai"
        self.assertEqual(round(k.parse_heartbeat(body, now)), 50)

    def test_patient_about_busy_page(self):
        k = _keeper()
        self.assertGreaterEqual(k.MAX_LAG_S, 400)
        self.assertGreaterEqual(k.LAG_FAILS_BEFORE_RELOAD, 3)


if __name__ == "__main__":
    unittest.main()
# @@END tests_v61_speed
