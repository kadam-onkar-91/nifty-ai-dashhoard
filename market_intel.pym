# market_intel.pym -- module bundle: Market brain, memory, adaptive learner, autopsy
# Each section between '# @@MODULE name' and '# @@END name' is the ORIGINAL module source, unchanged.
# bundle_loader.py imports every section as its own module (same import names as before).
# Modules in this bundle: market_brain, market_memory, market_adaptive, market_autopsy, market_learner
# @@MODULE market_brain
"""
market_brain.py -- one call from app.py:  market_brain.run(st, df, namespace)   (v46, purely additive, never raises)

Every refresh it (cheaply, once per new 5-min candle for the heavy parts):
  1. records the market (market_memory)            -> data for learning, back-filled on day one
  2. re-trains / re-validates the forecaster        -> market_learner
  3. runs the autopsy for every day in the candles  -> market_autopsy (and stores finished days permanently)
  4. draws the "Market Brain" panel.
It is ADVISORY: it never opens, blocks or edits a trade.
"""
from __future__ import annotations

import bisect
import logging

import pandas as pd

import market_adaptive as mad
import market_autopsy as ma
import market_learner as ml
import market_memory as mm
import trade_learning as tl
import trade_postmortem as tpm

logger = logging.getLogger(__name__)


def _pct(x):
    return "-" if x is None else f"{100 * x:.0f}%"


def _fc_compact(fc, ts):
    return {"ts": ts, "p_up25": fc.get("p_up25"), "p_up50": fc.get("p_up50"), "p_move50": fc.get("p_move50"),
            "trusted": bool(fc.get("trusted")), "lean": fc.get("lean"), "model": fc.get("model_used")}


def _trade_forecasts(snaps, trades):
    """Forecast that was stored at (just before) each engine trade's entry -> rows for the table."""
    withfc = [s for s in snaps if s.get("fc") and s["fc"].get("p_up25") is not None]
    keys = [s["ts"] for s in withfc]
    rows = []
    for t in trades:
        ts = str(t.get("timestamp") or "")[:19]
        i = bisect.bisect_right(keys, ts) - 1
        if i < 0:
            continue
        s = withfc[i]
        if (pd.Timestamp(ts) - pd.Timestamp(s["ts"])).total_seconds() > 600:
            continue
        v = ml.trade_view(dict(s["fc"], ready=True), t.get("direction"))
        rows.append({"Kab": ts[5:16], "Trade": f"{t.get('direction')} @ {float(t.get('underlying_entry') or 0):,.0f}", "Natija": t.get("status"),
                     "Forecaster ki raay": v["verdict"], "Trade ki disha ka chance": _pct(v["p_dir"]), "Validated?": "haan" if s["fc"].get("trusted") else "nahi"})
    return rows


def compute(df, ns):
    """Heavy work (cached by the caller).  -> dict for the panel."""
    out = {"ok": False}
    try:
        src = str((getattr(df, "attrs", {}) or {}).get("market_source") or ns.get("market_source") or "")
    except Exception:
        src = ""
    tradable = ("NON_TRADABLE" not in src) and ("UNAVAILABLE" not in src)
    d = mm.prep(df)
    if d is None:
        out["msg"] = "Candle data abhi kam/unavailable hai."
        return out
    extras = mm.build_extras(ns) if tradable else {}
    rec = mm.record(df, extras) if tradable else {"inserted": 0, "labelled": 0, "live_ts": None}
    F = mm.compute_features(d)
    f_now, ts_now = mm.latest_features(d, F, extras)
    snaps = mm.load_snapshots()
    fc = ml.forecast(snaps, f_now or {}) if f_now else {"ready": False, "msg": "features nahi bane"}
    if rec.get("live_ts") and fc.get("ready"):
        mm.save_forecast(rec["live_ts"], _fc_compact(fc, rec["live_ts"]))
    try:
        trades = tl.get_recent_setups(limit=40) or []
    except Exception:
        trades = []
    autopsies = ma.analyze_all(df, snaps, trades)
    stored = mm.load_days()
    for day, s in autopsies.items():                 # finished days are kept permanently (history longer than the candle window)
        if s.get("complete") and day not in stored:
            mm.save_day(day, s)
            stored[day] = s
    merged = dict(stored)
    merged.update(autopsies)
    pstats, pbase = ml.pattern_stats(snaps)
    out.update({"ok": True, "rec": rec, "fc": fc, "f_now": f_now or {}, "ts_now": ts_now, "snaps_n": len(snaps),
                "lab_n": sum(1 for s in snaps if s.get("y")), "live_n": sum(1 for s in snaps if s.get("src") == "live"),
                "days": merged, "pstats": pstats, "pbase": pbase, "score": ml.scorecard(snaps),
                "tf": _trade_forecasts(snaps, trades), "lessons": ma.lessons(list(merged.values()))})
    # ---- v47 adaptive layer: strategy scorecard, Gemini memory, earned engine nudge, daily upgrade log (all guarded, advisory)
    try:
        strat = mad.strategy_stats(snaps)
        try:
            import shadow_trades
            shadow = (shadow_trades.summary() or {}).get("by_gate", {})
        except Exception:
            shadow = {}
        gem_sc = mad.gemini_scorecard(trades, shadow)
        mad.update_state(fc, pstats, pbase, ml.active_patterns(f_now or {}), out["score"])
        out.update({"strat": strat, "shadow": shadow, "gem_sc": gem_sc, "adj": mad.adjustment_status()})
        out["gem_text"] = mad.gemini_context(out, trades, gem_sc, strat)
        mad.publish_gemini_text(out["gem_text"])
        day = (ts_now or "")[:10]
        if day:
            metrics = mad.daily_metrics(out, trades, day)
            mad.save_daily_metrics(metrics)
            stats = mm.load_stats()
            stats[day] = metrics
            out["stats"] = dict(sorted(stats.items()))
        out["suggest"] = mad.suggestions(out, shadow, strat)
    except Exception:
        logger.exception("adaptive layer failed (ignored)")
    # ---- v48 post-trade review: why each closed trade won / lost, which factors were right or wrong (advisory only)
    try:
        if tpm.ENABLED:
            pms = tpm.build(df)
            fr, gr = tpm.factor_board(pms)
            out["pm"] = {"trades": pms, "factors": fr, "groups": gr, "modes": tpm.mode_table(pms), "suggest": tpm.suggestions(pms),
                         "days": mm.load_pm_days()}
            day_ = (ts_now or "")[:10]
            if day_:
                tpm.save_day_reviews(pms, day_)
            ws = tpm.warn_stats(pms)
            tpm.update_state(ws)
            try:                                   # v52 amplifier: repeated "sold the bottom / bought the top" losses tighten the exhaustion guard
                import strategy_engine as _se
                _se.EXH_GUARD_MIN_MOVE_ATR = tpm.exhaustion_threshold(pms)
                out["pm"]["loc"] = tpm.location_stats(pms)
            except Exception:
                logger.exception("exhaustion amplifier failed (ignored)")
            mr, mg = tpm.missed_review(merged)
            out["pm"].update({"warn": ws, "missed": mr, "missed_gates": mg})
            note = tpm.gemini_note(pms)
            if note:                                   # keep the whole block inside the 1600-char limit ai_trade_decision reads
                base = out.get("gem_text") or ""
                cut = base[:1140]
                if len(base) > 1140 and "\n" in cut:
                    cut = cut[:cut.rfind("\n")]
                out["gem_text"] = (cut + "\n" + note).strip()
                mad.publish_gemini_text(out["gem_text"])
    except Exception:
        logger.exception("post-trade review failed (ignored)")
    return out


def run(st, df, ns):
    """Compute (cached per candle) and draw.  Safe: any error is logged and swallowed."""
    try:
        key = (str(df.index[-1]) if df is not None and len(df) else "", len(df) if df is not None else 0)
        ck = st.session_state.get("_mb_cache")
        if ck and ck.get("key") == key and (ck.get("t", 0) + 90) > __import__("time").time():
            res = ck["res"]
        else:
            res = compute(df, ns)
            st.session_state["_mb_cache"] = {"key": key, "res": res, "t": __import__("time").time()}
        _draw(st, res, ns)
    except Exception:
        logger.exception("market brain failed (ignored)")


# ----------------------------------------------------------------------------- UI
def _draw(st, res, ns):
    st.markdown("<br>", unsafe_allow_html=True)
    st.subheader("🧬 Market Brain (roz market se seekhne wala dimaag)")
    if not res.get("ok"):
        st.info(res.get("msg") or "Market Brain abhi data ka intezaar kar raha hai.")
        return
    st.caption(f"Har 5-min candle record hoti hai aur 60 min baad uska natija label hota hai. Seekha hua: {res['lab_n']} candles "
               f"({res['live_n']} live, baaki pichle din ka back-fill). Storage: {mm.storage_note()}. "
               "Ye sirf SALAAH/JAANKARI hai -- koi trade nahi kholta ya rokta.")
    fc = res["fc"]

    with st.expander("🔮 Agla 60-min move -- forecaster (data se, guarantee nahi)", expanded=False):
        if not fc.get("ready"):
            st.info(fc.get("msg") or "Data kam hai.")
        else:
            c1, c2, c3 = st.columns(3)
            lean = fc.get("lean")
            c1.metric("Jhukav", {"UP": "⬆️ UP", "DOWN": "⬇️ DOWN"}.get(lean, "↔️ NEUTRAL"))
            c2.metric("+25 pehle chhune ka chance", _pct(fc.get("p_up25")))
            c3.metric("50 pt move aane ka chance", _pct(fc.get("p_move50")))
            st.caption(("✅ " if fc.get("trusted") else "⚠️ ") + str(fc.get("msg")) +
                       (f" | agar 50 pt move aaya to UP hone ka chance: {_pct(fc.get('p_up50'))}" if fc.get("p_up50") is not None else ""))
            rep = (fc.get("reports") or {}).get("dir25") or {}
            if rep.get("val_n"):
                st.caption(f"Test (naye data par): {rep['val_n']} candles me sahi {_pct(rep.get('val_acc'))} vs 'bas majority guess' {_pct(rep.get('val_base_acc'))}, "
                           f"AUC {rep.get('val_auc')}. Trusted tabhi banta hai jab baseline se behtar nikle.")
            dec = ns.get("_decision")
            if isinstance(dec, dict) and dec.get("has_setup"):
                v = ml.trade_view(fc, dec.get("direction"))
                st.markdown(f"**Engine ke abhi ke {dec.get('direction')} trade par forecaster:** {v['verdict']} (is disha ka chance {_pct(v['p_dir'])})")
        act = ml.active_patterns(res["f_now"]) if res.get("f_now") else []
        if act:
            st.markdown("**Abhi active patterns:** " + " | ".join(ml.pattern_label(k) for k in act))
            ps = {p["key"]: p for p in res["pstats"]}
            lines = [f"• {p['text']}: 60 min me +25 pehle {_pct(p['up'])}, -25 pehle {_pct(p['dn'])} (n={p['n']})" for k in act if (p := ps.get(k))]
            if lines:
                st.caption("\n".join(lines))

    days = res["days"]
    with st.expander("🔬 Market Autopsy -- market kahan se palta aur kyon", expanded=False):
        if not days:
            st.info("Abhi autopsy ke liye poora din nahi mila.")
        else:
            options = sorted(days.keys(), reverse=True)
            pick = st.selectbox("Din chuno", options, index=0, key="mb_day")
            s = days[pick]
            st.markdown(f"**{pick}** | Open {s['open']:,.0f} | High {s['high']:,.0f} | Low {s['low']:,.0f} | Close {s['close']:,.0f} | "
                        f"Range {s['range']:.0f} pts" + ("" if s.get("complete") else " | (din abhi chal raha hai)"))
            st.caption(f"50+ pt ki {s['n_major']} moves me se engine ne {s['n_major_caught']} me sahi disha ka trade liya.")
            rows = []
            for lg in s["legs"]:
                rows.append({"Shuru": lg["start"], "Khatam": lg["end"], "Disha": "⬆️" if lg["dir"] == "UP" else "⬇️",
                             "Se → Tak": f"{lg['from']:,.0f} → {lg['to']:,.0f}", "Points": lg["pts"], "50+": "✅" if lg["major"] else "",
                             "Kyon palta (shuru par)": "; ".join(c["text"] for c in lg["causes"]) or "Koi clear technical trigger nahi mila (shayad news / bade order -- data me nahi)",
                             "Engine": ", ".join(lg.get("engine") or []) or ("miss" if lg["major"] else "")})
            if rows:
                st.dataframe(pd.DataFrame(rows), width="stretch", hide_index=True)
                ctx = [lg["context"] for lg in s["legs"] if lg.get("context")]
                if ctx:
                    st.caption("Live context (sabse bade turn par): " + ctx[0])
            st.caption("Ye kaaran data me dikhne wale sanket hain -- pakka saboot nahi. News ya bade players ke order data me nahi hote.")

    with st.expander("📚 Seekhe hue patterns (data se: kaun si situation ke baad kya hota hai)", expanded=False):
        ps = res["pstats"]
        if not ps:
            st.info("Abhi kisi pattern ke liye kaafi samples nahi (kam se kam 12 chahiye).")
        else:
            b = res["pbase"]
            st.caption(f"Base: {b['n']} candles me 60 min me +25 pehle {_pct(b['up'])}, -25 pehle {_pct(b['dn'])}.")
            st.dataframe(pd.DataFrame([{"Pattern": p["text"], "Samples": p["n"], "+25 pehle": _pct(p["up"]), "-25 pehle": _pct(p["dn"]),
                                        "Koi nahi": _pct(p["none"]), "UP edge": f"{100 * p['lift_up']:+.0f}", "DOWN edge": f"{100 * p['lift_dn']:+.0f}"} for p in ps]),
                         width="stretch", hide_index=True)
        L = res["lessons"]
        if L["majors"]:
            rk = ", ".join(f"{ma.CAUSE_NAMES.get(k, k)} ({v}/{L['majors']})" for k, v in L["ranking"][:5])
            st.caption(f"Ab tak {L['majors']} badi (50+ pt) moves dekhi, engine ne {L['caught']} pakdi. Un moves ke turn par sabse aam kaaran: {rk}.")

    with st.expander("🎯 Scorecard -- forecaster live kitna sahi nikla", expanded=False):
        sc = res["score"]
        if not sc.get("n"):
            st.info("Live forecasts ke natije abhi nahi aaye (har forecast ka natija 60 min baad pata chalta hai).")
        else:
            st.markdown(f"Live forecasts jinka natija aa chuka: **{sc['n']}** | sahi: **{_pct(sc['acc'])}**"
                        + (f" | confident wale ({sc['n_conf']}): {_pct(sc['acc_conf'])}" if sc.get("acc_conf") is not None else "")
                        + (f" | validated model ke ({sc['n_trusted']}): {_pct(sc['acc_trusted'])}" if sc.get("acc_trusted") is not None else ""))
        if res["tf"]:
            st.caption("Engine ke trades par forecaster ki raay (entry se pehle wali). Isse pata chalega ki wo losing trades pehle pakad leta ya nahi:")
            st.dataframe(pd.DataFrame(res["tf"]), width="stretch", hide_index=True)
        st.caption("Jab ye scorecard kaafi trades par sabit kare, tab forecaster ko trade ke gate me soft penalty ke taur par jodna theek hoga (abhi OFF).")

    with st.expander("📈 Roz ka Upgrade Report -- kya system sach me behtar ho raha hai?", expanded=False):
        adj = res.get("adj") or {}
        if adj:
            st.markdown("**Engine ko nudge:** " + ("🟢 forecaster ne kamaya hai (chalu)" if adj.get("forecaster_earned") else
                        f"⚪ abhi band (forecaster ko live me {adj.get('fc_live_n', 0)}/{mad.FC_MIN_LIVE_N} validated natije chahiye, aur {int(100 * mad.FC_MIN_ACC)}%+ sahi)")
                        + f" | solid patterns (50+ samples): {adj.get('patterns_with_enough_samples', 0)}")
            st.caption("Nudge hamesha chhota (max +/-3.5 percentage point) aur apne aap tabhi chalu hota hai jab saboot mile; saboot gayab to band.")
        stats = res.get("stats") or {}
        if stats:
            rows = [{"Din": d, "Seekhi candles": m.get("lab_n"), "Forecaster AUC (test)": m.get("fc_auc"), "Test sahi": _pct(m.get("fc_acc")),
                     "Baseline": _pct(m.get("fc_base")), "Trusted": "✅" if m.get("fc_trusted") else "", "Live sahi": _pct(m.get("live_acc")),
                     "Engine W-L": f"{m.get('engine_w', 0)}-{m.get('engine_l', 0)}"} for d, m in list(stats.items())[-14:]]
            st.markdown("**Din-ba-din trend** (asli saboot: kya AUC/accuracy badh rahi hai?)")
            st.dataframe(pd.DataFrame(rows), width="stretch", hide_index=True)
        strat = res.get("strat") or {}
        if strat:
            st.markdown("**Strategy scorecard (live)**")
            st.dataframe(pd.DataFrame([{"Strategy": k, "Signals": v["samples"], "Sahi disha": f"{v['wins']}/{v['samples']}", "Asli %": v["raw_win_rate"],
                                        "Random candle %": v["expected_win_rate"], "Score par asar (pts)": round(max(-8.0, min(8.0, (v["win_rate"] - 50.0) * 0.16)), 1)}
                                       for k, v in sorted(strat.items(), key=lambda z: -z[1]["win_rate"])]), width="stretch", hide_index=True)
        else:
            st.caption(f"Strategy scorecard abhi khali: har strategy ke kam se kam {mad.STRAT_MIN_EPISODES} live signals ka natija chahiye (dashboard khula rahe to roz judta hai).")
        g = res.get("gem_sc") or {}
        if g.get("approved_n") or g.get("rejected_n"):
            st.markdown(f"**Gemini scorecard:** approve kiye hue trades me {g.get('approved_wins', 0)}/{g.get('approved_n', 0)} jeete ({_pct(g.get('approved_wr'))})"
                        + (f" | jo setups Gemini ne roke unme {g['rejected_would_win']}/{g['rejected_n']} jeet jaate ({_pct(g.get('rejected_wr'))})" if g.get("rejected_n") else ""))
        if g.get("by_model"):
            st.caption("Gemini approvals model-wise (jeet/total): " + ", ".join(f"{m} {v['wins']}/{v['n']}" for m, v in sorted(g["by_model"].items(), key=lambda z: -z[1]["n"]))
                       + ". Sample chhota ho to isse natija mat nikalo.")
        if res.get("gem_text"):
            st.caption("Gemini ko review se pehle ye yaaddasht milti hai (salaah, live data ko override nahi kar sakti):")
            st.code(res["gem_text"], language=None)
        for s_ in (res.get("suggest") or []):
            st.markdown("• " + s_)
        st.caption("Suggestions sirf jaankari hain -- koi hard gate, SL ya target apne aap nahi badalta.")

    _draw_postmortem(st, res.get("pm"))


def _draw_postmortem(st, pm):
    with st.expander("🩺 Trade Post-Mortem -- har trade kyon jeeta / kyon haara (roz seekhta hai)", expanded=False):
        if not pm or not pm.get("trades"):
            st.info("Abhi koi band trade nahi mila. Trade band hote hi uska post-mortem yahan banega.")
            return
        T = pm["trades"]
        done = [t for t in T if t["status"] in ("WIN", "LOSS")]
        w = sum(t["status"] == "WIN" for t in done)
        st.caption(f"{len(T)} band trades ka review ({w} jeet / {len(done) - w} haar). Ye SIRF jaankari/salaah hai -- koi trade, SL ya target apne aap nahi badalta.")
        if pm.get("modes"):
            st.markdown("**Haar ke kaaran (loss kaise hue)**")
            st.dataframe(pd.DataFrame([{"Kaaran": m["text"], "Trades": m["n"], "Hissa": _pct(m["share"])} for m in pm["modes"]]),
                         width="stretch", hide_index=True)
        if pm.get("groups"):
            st.markdown("**Signal groups: aligned hone par kya sach me jeete? (global / news / fundamentals / strategy ...)**")
            st.dataframe(pd.DataFrame([{"Group": g["factor"], "Aligned trades": g["aligned_n"], "Aligned jeet": _pct(g["aligned_wr"]),
                                        "Na-aligned trades": g["not_n"], "Na-aligned jeet": _pct(g["not_wr"]), "Natija": g["verdict"]} for g in pm["groups"]]),
                         width="stretch", hide_index=True)
            st.caption(f"Verdict tabhi aata hai jab dono taraf kam se kam {tpm.MIN_GROUP_N} trades hon aur farq statistically saaf ho; warna 'data kam'.")
        if pm.get("factors"):
            with st.expander("Har factor alag se", expanded=False):
                st.dataframe(pd.DataFrame([{"Factor": f["factor"], "Group": f["group"], "Aligned": f["aligned_n"], "Aligned jeet": _pct(f["aligned_wr"]),
                                            "Na-aligned": f["not_n"], "Na-aligned jeet": _pct(f["not_wr"]), "Natija": f["verdict"]} for f in pm["factors"]]),
                             width="stretch", hide_index=True)
        ws = pm.get("warn") or {}
        if ws.get("hi_n") or ws.get("lo_n"):
            st.markdown(f"**Chetawani-filter:** jab aadhe+ signal groups trade ke khilaf the, trades {_pct(ws.get('hi_wr'))} jeete ({ws.get('hi_n', 0)} trades) "
                        f"vs baaki {_pct(ws.get('lo_wr'))} ({ws.get('lo_n', 0)}). " +
                        ("🟢 Saabit ho chuka -- isliye aise naye trade par chhota penalty (max ~2.5 pt) lag raha hai." if ws.get("earned") else
                         f"⚪ Abhi saabit nahi (dono taraf {tpm.WARN_MIN_N}+ trades aur saaf farq chahiye) -- penalty band."))
        if pm.get("missed"):
            st.markdown("**Jo badi moves chhoot gayi -- us waqt kaun sa gate bola?**")
            if pm.get("missed_gates"):
                st.caption("Gate-wise chhoote 50+ pt moves: " + ", ".join(f"{g}: {n}" for g, n in sorted(pm["missed_gates"].items(), key=lambda z: -z[1])))
            st.dataframe(pd.DataFrame([{"Din": r["day"], "Shuru": r["start"], "Disha": "⬆️" if r["dir"] == "UP" else "⬇️", "Points": r["pts"],
                                        "Gate": r["gate"], "Wajah": r["reason"]} for r in pm["missed"]]), width="stretch", hide_index=True)
            st.caption("Agar ek gate bar-bar badi moves rokta dikhe aur shadow trades me wo jeet-te hon, tab use dheela karna soch sakte hain (apne aap nahi hota).")
        for s_ in pm.get("suggest") or []:
            st.markdown("• " + s_)
        st.markdown("**Har trade ki kahani (naya pehle)**")
        for t in T[:12]:
            icon = {"WIN": "✅", "LOSS": "❌"}.get(t["status"], "⏱️")
            st.markdown(f"{icon} **{t['day']} {t['time']}** {t['status']} -- {t['story']}")
        st.caption("Kaaran data me dikhne wale sanket hain. News ya bade players ka asli asar data me nahi hota -- usse pakka nahi kaha ja sakta.")

# @@END market_brain
# @@MODULE market_memory
"""
market_memory.py -- the MARKET RECORDER (v46, purely additive).

WHY
  The trade engine only learns from its own few trades.  The market gives ~75 five-minute candles every day, and every one
  of them is a free lesson: "the market looked like THIS, and the next 60 minutes did THAT".  This module records exactly that.

WHAT IT DOES
  1. For every COMPLETED 5-min candle it saves a feature snapshot (price action, volume, RSI/EMA/VWAP stretch, day position,
     opening range ... and, when the app is live, option-chain OI walls, PCR, VIX, breadth, global mood, strategy state).
  2. Once 12 more candles exist it adds the OUTCOME label: how far price went up / down in the next 60 min and which of the
     +/-25 pt and +/-50 pt levels was touched FIRST.
  3. On the first run it BACK-FILLS from the candles the app already has (about a week) so learning starts on day one
     (price-only features; the live-only extras start accumulating from today).

STORAGE  Supabase tables `market_snapshots` / `market_autopsy` if they exist (run SUPABASE_MARKET_BRAIN_MIGRATION.sql once),
         otherwise the local SQLite file (works, but is lost when the app restarts -- the back-fill re-creates the price part).

SAFETY   Nothing here can open, block or change a trade.  Every public function swallows its own errors.
"""
from __future__ import annotations

import json
import logging
import math
import sqlite3
import time
from datetime import time as dtime
from urllib.parse import quote

import numpy as np
import pandas as pd
import sb_http as requests   # shared Supabase session + circuit breaker (non-Supabase URLs behave exactly like requests)

import trade_learning as tl

logger = logging.getLogger(__name__)

SNAP_TABLE = "market_snapshots"
DAY_TABLE = "market_autopsy"
HORIZON_BARS = 12            # 12 x 5 min = 60 min look-ahead
MIN_PARTIAL_BARS = 4         # end-of-day candles: label with what is left of the session once the day is over
MOVE_LEVELS = (25.0, 50.0)
MARKET_OPEN = dtime(9, 15)
MARKET_CLOSE = dtime(15, 30)

# features every row has (computed from the candles alone -> also available for the back-fill)
BASE_FEATS = [
    "ema20_dist_atr", "ema50_dist_atr", "rsi", "macd_h_atr", "bb_pos", "vwap_dist_atr", "vol_ratio", "candle_atr",
    "range_atr", "upper_wick", "lower_wick", "run6_atr", "streak", "day_move_pct", "day_pos", "dist_dayhigh_atr",
    "dist_daylow_atr", "dist_pdh_atr", "dist_pdl_atr", "or_pos", "round50_dist", "mins_since_open", "atr",
]
# live-only extras (None for back-filled rows)
EXT_FEATS = ["pcr", "vix", "breadth_net", "global_avg", "call_wall_dist", "put_wall_dist",
             "call_wall_share", "put_wall_share", "strat_dir", "strat_score"]
EXTRA_KEYS = EXT_FEATS + ["call_wall", "put_wall", "news_sent", "sr_loc", "strats"]

_SB_RETRY_S = 600
_sb_state: dict = {}
_cache: dict = {}
_state: dict = {"key": None}


# ----------------------------------------------------------------------------- small helpers
def _f(x, default=None):
    try:
        v = float(x)
        return default if (math.isnan(v) or math.isinf(v)) else v
    except Exception:
        return default


def ts_str(ts) -> str:
    t = pd.Timestamp(ts)
    if t.tzinfo is not None:
        t = t.tz_convert("Asia/Kolkata").tz_localize(None)
    return t.strftime("%Y-%m-%d %H:%M:%S")


def prep(df):
    """Candle DataFrame -> clean copy with a naive-IST DatetimeIndex and every column the features need, or None."""
    try:
        if df is None or len(df) < 30:
            return None
        d = df.copy()
        idx = d.index if isinstance(d.index, pd.DatetimeIndex) else pd.DatetimeIndex(pd.to_datetime(d.index))
        if idx.tz is not None:
            idx = idx.tz_convert("Asia/Kolkata").tz_localize(None)
        d.index = idx
        d = d[~d.index.duplicated(keep="last")].sort_index()
        for col in ("Open", "High", "Low", "Close"):
            if col not in d.columns:
                return None
            d[col] = pd.to_numeric(d[col], errors="coerce")
        d = d.dropna(subset=["Open", "High", "Low", "Close"])
        if len(d) < 30:
            return None
        d["Volume"] = pd.to_numeric(d["Volume"], errors="coerce").fillna(0.0) if "Volume" in d.columns else 0.0
        c = d["Close"]
        if "ATR" not in d.columns:
            tr = pd.concat([d["High"] - d["Low"], (d["High"] - c.shift()).abs(), (d["Low"] - c.shift()).abs()], axis=1).max(axis=1)
            d["ATR"] = tr.ewm(span=14, adjust=False).mean()
        d["ATR"] = pd.to_numeric(d["ATR"], errors="coerce").replace(0, np.nan).ffill().bfill().fillna(c * 0.002)
        if "EMA_20" not in d.columns:
            d["EMA_20"] = c.ewm(span=20, adjust=False).mean()
        if "EMA_50" not in d.columns:
            d["EMA_50"] = c.ewm(span=50, adjust=False).mean()
        if "RSI" not in d.columns:
            dl = c.diff()
            up = dl.clip(lower=0).ewm(alpha=1 / 14, adjust=False).mean()
            dn = (-dl.clip(upper=0)).ewm(alpha=1 / 14, adjust=False).mean()
            d["RSI"] = (100 - 100 / (1 + up / dn.replace(0, np.nan))).fillna(50)
        if "MACD_Hist" not in d.columns:
            m = c.ewm(span=12, adjust=False).mean() - c.ewm(span=26, adjust=False).mean()
            d["MACD_Hist"] = m - m.ewm(span=9, adjust=False).mean()
        if "BB_Upper" not in d.columns or "BB_Lower" not in d.columns:
            mid = c.rolling(20, min_periods=5).mean()
            sd = c.rolling(20, min_periods=5).std()
            d["BB_Upper"], d["BB_Lower"] = mid + 2 * sd, mid - 2 * sd
        return d
    except Exception:
        logger.exception("market_memory.prep failed (ignored)")
        return None


# ----------------------------------------------------------------------------- features
def compute_features(d: pd.DataFrame) -> pd.DataFrame:
    """One feature row per candle (BASE_FEATS + price/atr).  Pure function of the candles -> same code for back-fill and live."""
    o, h, l, c, v = d["Open"], d["High"], d["Low"], d["Close"], d["Volume"]
    atr = d["ATR"]
    day = pd.Series(d.index.normalize(), index=d.index)
    rng = (h - l).replace(0, np.nan)

    dhigh = h.groupby(day).cummax()
    dlow = l.groupby(day).cummin()
    d_last_close = c.groupby(day).last()
    prev_close = day.map(d_last_close.shift(1))
    day_open = o.groupby(day).transform("first")
    ref = prev_close.fillna(day_open)
    day_high_full = h.groupby(day).max()
    day_low_full = l.groupby(day).min()
    pdh = day.map(day_high_full.shift(1))
    pdl = day.map(day_low_full.shift(1))

    tp = (h + l + c) / 3
    vol_ok = v.groupby(day).transform("sum") > 0
    w = v.where(vol_ok, 1.0)          # days with real volume: volume-weighted; days without (index spot): equal weights
    vwap = (tp * w).groupby(day).cumsum() / w.groupby(day).cumsum().replace(0, np.nan)
    vwap = vwap.fillna(tp)

    vr = v / v.rolling(20, min_periods=5).mean().replace(0, np.nan)
    vr = vr.fillna(1.0) if bool(vol_ok.any()) else pd.Series(1.0, index=d.index)

    bar_no = c.groupby(day).cumcount()
    or_h = h.where(bar_no < 6).groupby(day).transform("max")
    or_l = l.where(bar_no < 6).groupby(day).transform("min")
    or_pos = pd.Series(0.0, index=d.index)
    or_pos = or_pos.mask((bar_no >= 6) & (c > or_h), 1.0).mask((bar_no >= 6) & (c < or_l), -1.0)

    body = c - o
    streak = []
    s = 0
    for b in body.values:
        col = 1 if b > 0 else -1 if b < 0 else 0
        s = (s + col if (s > 0 and col > 0) or (s < 0 and col < 0) else col)
        streak.append(s)

    mins = (d.index.hour * 60 + d.index.minute) - (9 * 60 + 15)
    bbu, bbl = d["BB_Upper"], d["BB_Lower"]
    f = pd.DataFrame(index=d.index)
    f["ema20_dist_atr"] = (c - d["EMA_20"]) / atr
    f["ema50_dist_atr"] = (c - d["EMA_50"]) / atr
    f["rsi"] = d["RSI"]
    f["macd_h_atr"] = d["MACD_Hist"] / atr
    f["bb_pos"] = ((c - bbl) / (bbu - bbl).replace(0, np.nan)).clip(-0.5, 1.5)
    f["vwap_dist_atr"] = (c - vwap) / atr
    f["vol_ratio"] = vr.clip(0, 6)
    f["candle_atr"] = body / atr
    f["range_atr"] = (h - l) / atr
    f["upper_wick"] = ((h - np.maximum(o, c)) / rng).fillna(0)
    f["lower_wick"] = ((np.minimum(o, c) - l) / rng).fillna(0)
    f["run6_atr"] = (c - c.shift(6)) / atr
    f["streak"] = streak
    f["day_move_pct"] = (c - ref) / ref * 100
    f["day_pos"] = ((c - dlow) / (dhigh - dlow).replace(0, np.nan)).fillna(0.5)
    f["dist_dayhigh_atr"] = (dhigh - c) / atr
    f["dist_daylow_atr"] = (c - dlow) / atr
    f["dist_pdh_atr"] = (c - pdh) / atr
    f["dist_pdl_atr"] = (c - pdl) / atr
    f["or_pos"] = or_pos
    f["round50_dist"] = np.minimum(c % 50, 50 - (c % 50))
    f["mins_since_open"] = mins
    f["atr"] = atr
    f["price"] = c
    f["vwap"] = vwap
    return f.replace([np.inf, -np.inf], np.nan)


# ----------------------------------------------------------------------------- outcome labels
def closed_days(d: pd.DataFrame, now=None) -> set:
    """Dates whose session is over (every date before the last one; the last one too once it printed a >=15:25 candle)."""
    dates = sorted(set(d.index.normalize()))
    if not dates:
        return set()
    out = set(dates[:-1])
    last = d.index[-1]
    if last.time() >= dtime(15, 25):
        out.add(dates[-1])
    return out


def compute_labels(d: pd.DataFrame, closed: set | None = None) -> dict:
    """ts_str -> {'up','dn','ret','f25','f50','bars'}  (None where the look-ahead is not finished yet).
    f25/f50 = which of +/-25 / +/-50 pts price touched FIRST inside the next 12 candles of the SAME day: UP, DN, NONE or AMB
    (both inside one candle -- order unknowable, ignored by the learners)."""
    closed = closed if closed is not None else closed_days(d)
    h, l, c = d["High"].values, d["Low"].values, d["Close"].values
    days = d.index.normalize()
    day_vals = days.values
    last_idx: dict = {}
    for i, dd in enumerate(day_vals):
        last_idx[dd] = i
    out = {}
    for i in range(len(d)):
        end = min(i + HORIZON_BARS, last_idx[day_vals[i]])
        nb = end - i
        full = nb == HORIZON_BARS
        if nb < 1 or not (full or (days[i] in closed and nb >= MIN_PARTIAL_BARS)):
            out[ts_str(d.index[i])] = None
            continue
        res = {25.0: "NONE", 50.0: "NONE"}
        done = {25.0: False, 50.0: False}
        mu = md = 0.0
        for j in range(i + 1, end + 1):
            up, dn = h[j] - c[i], c[i] - l[j]
            mu, md = max(mu, up), max(md, dn)
            for T in MOVE_LEVELS:
                if done[T]:
                    continue
                u, dw = up >= T, dn >= T
                if u and dw:
                    res[T], done[T] = "AMB", True
                elif u:
                    res[T], done[T] = "UP", True
                elif dw:
                    res[T], done[T] = "DN", True
        out[ts_str(d.index[i])] = {"up": round(float(mu), 1), "dn": round(float(md), 1), "ret": round(float(c[end] - c[i]), 1),
                                   "f25": res[25.0], "f50": res[50.0], "bars": int(nb)}
    return out


# ----------------------------------------------------------------------------- live-only extras
def chain_walls(raw_chain, price):
    """Nearest-big OI walls from the option chain DataFrame (columns Strike / Call OI / Put OI).  -> dict (may be empty)."""
    try:
        if not isinstance(raw_chain, pd.DataFrame) or raw_chain.empty or price is None:
            return {}
        cols = {str(k).lower(): k for k in raw_chain.columns}
        ks, kc, kp = cols.get("strike"), cols.get("call oi"), cols.get("put oi")
        if not (ks and kc and kp):
            return {}
        t = raw_chain[[ks, kc, kp]].apply(pd.to_numeric, errors="coerce").dropna()
        t = t[(t[ks] > price - 400) & (t[ks] < price + 400)]
        if t.empty:
            return {}
        above = t[t[ks] >= price - 5]
        below = t[t[ks] <= price + 5]
        out = {}
        mc, mp = float(t[kc].max()), float(t[kp].max())
        if not above.empty and mc > 0:
            r = above.loc[above[kc].idxmax()]
            out.update(call_wall=float(r[ks]), call_wall_dist=float(r[ks] - price), call_wall_share=float(r[kc]) / mc)
        if not below.empty and mp > 0:
            r = below.loc[below[kp].idxmax()]
            out.update(put_wall=float(r[ks]), put_wall_dist=float(r[ks] - price), put_wall_share=float(r[kp]) / mp)
        return out
    except Exception:
        return {}


def build_extras(ns: dict) -> dict:
    """Pick the live extras out of the app's variables (all optional)."""
    ex = {}
    try:
        price = _f(ns.get("live_price"))
        ex.update(chain_walls(ns.get("df_option_chain"), price))
        ex["pcr"] = _f(ns.get("current_pcr"))
        ex["vix"] = _f(ns.get("live_vix"))
        adv, dec = _f(ns.get("advances")), _f(ns.get("declines"))
        if adv is not None and dec is not None and (adv + dec) > 0:
            ex["breadth_net"] = (adv - dec) / (adv + dec)
        ex["global_avg"] = _f(ns.get("avg_market_change"))
        sr = ns.get("strategy_result")
        if isinstance(sr, dict):
            ex["strat_dir"] = 1.0 if sr.get("direction") == "BUY" else -1.0 if sr.get("direction") == "SELL" else 0.0
            ex["strat_score"] = _f(sr.get("score"))
        ra = sr.get("ranked_active") if isinstance(sr, dict) else None
        if isinstance(ra, list):             # which named strategies are live (and valid) right now -> strategy scorecard
            ex["strats"] = [f"{r.get('key')}:{r.get('direction')}" for r in ra
                            if isinstance(r, dict) and r.get("live_valid") and r.get("key") and r.get("direction")][:12]
        src = ns.get("sr_context")
        if isinstance(src, dict):
            ex["sr_loc"] = str(src.get("location", ""))[:20]
    except Exception:
        logger.exception("build_extras failed (ignored)")
    return {k: v for k, v in ex.items() if v is not None}


# ----------------------------------------------------------------------------- storage
def _sb_ok(table):
    if not tl._is_supabase_configured():
        return False
    now = time.time()
    st = _sb_state.get(table)
    if st and now - st[1] < _SB_RETRY_S:
        return st[0]
    try:
        r = requests.get(f"{tl._supabase_url}/rest/v1/{table}?select=*&limit=1", headers=tl._supabase_headers(), timeout=8)
        ok = r.status_code == 200
    except Exception:
        ok = False
    _sb_state[table] = (ok, now)
    return ok


def _local():
    conn = sqlite3.connect(tl.DB_NAME)
    conn.execute("CREATE TABLE IF NOT EXISTS market_snapshots (ts TEXT PRIMARY KEY, features TEXT, labels TEXT, src TEXT, forecast TEXT)")
    conn.execute("CREATE TABLE IF NOT EXISTS market_autopsy (day TEXT PRIMARY KEY, summary TEXT)")
    conn.commit()
    return conn


def storage_note():
    if tl._is_supabase_configured() and _sb_ok(SNAP_TABLE):
        return "Supabase (permanent)"
    if tl._is_supabase_configured():
        return "local file ONLY -- SUPABASE_MARKET_BRAIN_MIGRATION.sql ek baar Supabase me run karo tabhi data permanent hoga"
    return "local file (restart par mit sakta hai)"


def _j(x):
    try:
        return json.loads(x) if isinstance(x, str) and x else (x if isinstance(x, dict) else None)
    except Exception:
        return None


def load_snapshots(max_rows=6000, force=False):
    """All snapshots, oldest first: [{'ts','f','y','src','fc'}]."""
    hit = _cache.get("snaps")
    if hit and not force and time.time() - hit[0] < 45:
        return hit[1]
    raw = None
    if _sb_ok(SNAP_TABLE):
        try:
            raw, off = [], 0
            while off < max_rows:
                r = requests.get(f"{tl._supabase_url}/rest/v1/{SNAP_TABLE}?select=ts,features,labels,src,forecast&order=ts.desc&limit=1000&offset={off}",
                                 headers=tl._supabase_headers(), timeout=15)
                r.raise_for_status()
                part = r.json()
                raw += part
                if len(part) < 1000:
                    break
                off += 1000
        except Exception:
            logger.exception("market snapshots read (supabase) failed; using local")
            raw = None
    if raw is None:
        conn = _local()
        conn.row_factory = sqlite3.Row
        raw = [dict(x) for x in conn.execute("SELECT ts,features,labels,src,forecast FROM market_snapshots ORDER BY ts DESC LIMIT ?", (max_rows,)).fetchall()]
        conn.close()
    rows = [{"ts": r["ts"], "f": _j(r.get("features")) or {}, "y": _j(r.get("labels")), "src": r.get("src") or "backfill", "fc": _j(r.get("forecast"))} for r in raw]
    rows.sort(key=lambda z: z["ts"])
    _cache["snaps"] = (time.time(), rows)
    return rows


def _insert_many(rows):
    if not rows:
        return
    _cache.pop("snaps", None)
    if _sb_ok(SNAP_TABLE):
        try:
            for i in range(0, len(rows), 200):
                r = requests.post(f"{tl._supabase_url}/rest/v1/{SNAP_TABLE}?on_conflict=ts",
                                  headers={**tl._supabase_headers(), "Prefer": "resolution=ignore-duplicates,return=minimal"},
                                  json=rows[i:i + 200], timeout=20)
                r.raise_for_status()
            return
        except Exception:
            logger.exception("market snapshots insert (supabase) failed; using local")
    conn = _local()
    conn.executemany("INSERT OR IGNORE INTO market_snapshots (ts,features,labels,src,forecast) VALUES (?,?,?,?,?)",
                     [(r["ts"], r["features"], r["labels"], r["src"], r.get("forecast")) for r in rows])
    conn.commit()
    conn.close()


def _update(ts, **cols):
    _cache.pop("snaps", None)
    if _sb_ok(SNAP_TABLE):
        try:
            r = requests.patch(f"{tl._supabase_url}/rest/v1/{SNAP_TABLE}?ts=eq.{quote(str(ts), safe='')}", headers=tl._supabase_headers(), json=cols, timeout=10)
            r.raise_for_status()
            return
        except Exception:
            logger.exception("market snapshot update (supabase) failed; using local")
    conn = _local()
    sets = ",".join(f"{k}=?" for k in cols)
    conn.execute(f"UPDATE market_snapshots SET {sets} WHERE ts=?", (*cols.values(), ts))
    conn.commit()
    conn.close()


def save_forecast(ts, forecast: dict):
    try:
        _update(ts, forecast=json.dumps(forecast, default=str))
    except Exception:
        logger.exception("save_forecast failed (ignored)")


def _load_day_rows():
    """Every row of the autopsy table: {key: dict}.  Keys 'YYYY-MM-DD' = day autopsies, 'stats-YYYY-MM-DD' = daily upgrade metrics."""
    hit = _cache.get("days")
    if hit and time.time() - hit[0] < 60:
        return hit[1]
    raw = None
    if _sb_ok(DAY_TABLE):
        try:
            r = requests.get(f"{tl._supabase_url}/rest/v1/{DAY_TABLE}?select=day,summary&order=day.desc&limit=400", headers=tl._supabase_headers(), timeout=10)
            r.raise_for_status()
            raw = r.json()
        except Exception:
            logger.exception("autopsy read (supabase) failed; using local")
            raw = None
    if raw is None:
        conn = _local()
        conn.row_factory = sqlite3.Row
        raw = [dict(x) for x in conn.execute("SELECT day,summary FROM market_autopsy ORDER BY day DESC LIMIT 400").fetchall()]
        conn.close()
    out = {}
    for r in raw:
        s = _j(r.get("summary"))
        if s:
            out[r["day"]] = s
    _cache["days"] = (time.time(), out)
    return out


def load_days():
    """Stored daily autopsies: {day: summary_dict}."""
    return {k: v for k, v in _load_day_rows().items() if not str(k).startswith(("stats-", "pm-"))}


def load_pm_days():
    """v48: stored daily post-trade reviews {day: summary_dict}, oldest first (rows keyed 'pm-YYYY-MM-DD')."""
    rows = {k[3:]: v for k, v in _load_day_rows().items() if str(k).startswith("pm-")}
    return dict(sorted(rows.items()))


def load_stats():
    """Stored daily upgrade metrics: {day: metrics_dict}, oldest first."""
    rows = {k[6:]: v for k, v in _load_day_rows().items() if str(k).startswith("stats-")}
    return dict(sorted(rows.items()))


def save_day(day, summary: dict):
    _cache.pop("days", None)
    payload = json.dumps(summary, default=str)
    if _sb_ok(DAY_TABLE):
        try:
            r = requests.post(f"{tl._supabase_url}/rest/v1/{DAY_TABLE}?on_conflict=day",
                              headers={**tl._supabase_headers(), "Prefer": "resolution=merge-duplicates,return=minimal"},
                              json=[{"day": day, "summary": payload}], timeout=10)
            r.raise_for_status()
            return
        except Exception:
            logger.exception("autopsy save (supabase) failed; using local")
    conn = _local()
    conn.execute("INSERT OR REPLACE INTO market_autopsy (day,summary) VALUES (?,?)", (day, payload))
    conn.commit()
    conn.close()


# ----------------------------------------------------------------------------- the recorder
def _clean(rowdict):
    return {k: (None if (isinstance(v, float) and (math.isnan(v) or math.isinf(v))) else (round(v, 4) if isinstance(v, float) else v))
            for k, v in rowdict.items()}


def latest_features(d, F, extras=None):
    """Feature dict of the latest COMPLETED candle (+ live extras) and its timestamp string, or (None, None)."""
    try:
        now = tl._now_ist()
        forming = now.weekday() < 5 and MARKET_OPEN <= now.time() <= MARKET_CLOSE and d.index[-1].date() == now.date()
        row = F.iloc[-2] if forming and len(F) > 1 else F.iloc[-1]
        ts = ts_str(F.index[-2] if forming and len(F) > 1 else F.index[-1])
        f = _clean(row.to_dict())
        f.update(extras or {})
        return f, ts
    except Exception:
        return None, None


def record(df, extras=None):
    """Save new completed candles (+ back-fill), then add outcome labels where the 60-min look-ahead is finished.
    Runs the heavy part once per new candle.  Returns {'inserted','labelled','live_ts'} -- never raises."""
    out = {"inserted": 0, "labelled": 0, "live_ts": None}
    try:
        d = prep(df)
        if d is None:
            return out
        now = tl._now_ist()
        forming = now.weekday() < 5 and MARKET_OPEN <= now.time() <= MARKET_CLOSE and d.index[-1].date() == now.date()
        done = d.iloc[:-1] if forming else d
        if len(done) < 30:
            return out
        key = (ts_str(done.index[-1]), len(done))
        if _state.get("key") == key:
            return out
        F = compute_features(done)
        labs = compute_labels(done)
        snaps = load_snapshots(force=True)
        known = {s["ts"]: s for s in snaps}
        last_ts = ts_str(done.index[-1])

        new_rows = []
        for ts in F.index:
            t = ts_str(ts)
            if t in known:
                continue
            f = _clean(F.loc[ts].to_dict())
            live = (t == last_ts and bool(extras))
            if live:
                f.update(extras)
            y = labs.get(t)
            new_rows.append({"ts": t, "features": json.dumps(f), "labels": json.dumps(y) if y else None,
                             "src": "live" if live else "backfill", "forecast": None})
        _insert_many(new_rows)
        out["inserted"] = len(new_rows)
        out["live_ts"] = last_ts if any(r["ts"] == last_ts and r["src"] == "live" for r in new_rows) else None

        pend = 0
        for s in snaps:
            if s["y"] is None and labs.get(s["ts"]):
                _update(s["ts"], labels=json.dumps(labs[s["ts"]]))
                pend += 1
                if pend >= 400:
                    break
        out["labelled"] = pend
        _state["key"] = key
    except Exception:
        logger.exception("market_memory.record failed (ignored)")
    return out
# @@END market_memory
# @@MODULE market_adaptive
"""
market_adaptive.py -- makes the WHOLE tool improve day by day, safely (v47, additive).

Four jobs, all bounded, all fail-safe, all with a kill switch (ENABLED / ENGINE_ADJUST):

1. STRATEGY SCORECARD  Market Brain records which named strategies were live on every 5-min candle.  Once the 60-min outcome is known
   each strategy "episode" (a signal that appears and stays) is scored: did price touch +25 in its direction BEFORE -25 against it,
   compared with what a random candle does?  The result feeds strategy_engine's existing small ranking bonus/penalty (max +/-8 pts,
   in practice far less because of shrinkage).  (The old hook `trade_learning.get_strategy_performance` did not exist, so strategies
   never learned from live outcomes at all -- this replaces that dead hook.)
2. GEMINI MEMORY       Gemini's final review prompt gets a short "what this system learned" block (its own recent track record, patterns,
   forecaster status, weak/strong strategies, main reversal reasons).  Advisory only -- it can never override the live packet.
3. ENGINE ADJUSTMENT   A tiny probability nudge (max +/-0.15 logit ~ +/-3.5 pct points) from the forecaster and from statistically
   solid patterns.  It switches ITSELF on only when the evidence has been earned (see engine_adjustment) and off again if it stops.
4. DAILY UPGRADE LOG   One metrics row per day (data learned, forecaster quality, live accuracy, engine win rate ...) so you can SEE
   whether the system is really getting better, plus plain-language suggestions (never auto-applied).

Nothing here edits a stored trade, a table the old code uses, or a hard gate.
"""
from __future__ import annotations

import logging
import math
import time

import pandas as pd

import market_memory as mm

logger = logging.getLogger(__name__)

ENABLED = True                 # master kill switch
ENGINE_ADJUST = "auto"         # "off" = never touch the engine probability;  "auto" = only when earned
FC_MIN_LIVE_N = 30             # live, validated forecasts with a known outcome needed before the forecaster may nudge the engine
FC_MIN_ACC = 0.55              # ... and they must have been right at least this often
FC_CAP = 0.12
PAT_MIN_EFF_N = 12             # a pattern needs this many INDEPENDENT-equivalent samples (~100 raw candles) ...
PAT_OVERLAP = 8.0              # ... neighbouring candles share most of their 60-min look-ahead, so n raw candles ~ n/8 independent ones
PAT_Z = 2.3                    # ... and its edge must hold at ~99% confidence
PAT_BONUS = 0.05
PAT_PENALTY = 0.06
TOTAL_CAP = 0.15
STRAT_MIN_EPISODES = 10
STRAT_SHRINK_K = 20            # prior strength: 20 imaginary "average" outcomes pull small samples back to neutral
EPISODE_GAP_MIN = 15           # a strategy still live within 15 min of its last sighting is the SAME episode
GEMINI_TEXT_MAX = 1500

_STATE: dict = {"fc": None, "pstats": {}, "pbase": {}, "active": [], "score": {}, "ts": 0.0}
_strat_cache: dict = {"key": None, "val": {}}
_last_metrics_save = {"t": 0.0}


def wilson(wins, n, z=1.96):
    if n <= 0:
        return 0.0, 1.0
    p = wins / n
    d = 1 + z * z / n
    c = p + z * z / (2 * n)
    r = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n))
    return (c - r) / d, (c + r) / d


# ----------------------------------------------------------------------------- 1. strategy scorecard
def _compute_strategy_stats(snaps):
    lab = [s for s in snaps if s.get("y") and s["y"].get("f25") in ("UP", "DN")]
    up_d = (sum(1 for s in lab if s["y"]["f25"] == "UP") / len(lab)) if len(lab) >= 60 else 0.5
    acc: dict = {}
    last_seen: dict = {}
    for s in snaps:
        if s.get("src") != "live":
            continue
        strats = (s.get("f") or {}).get("strats") or []
        if not isinstance(strats, list):
            continue
        t = pd.Timestamp(s["ts"])
        for item in strats:
            key, _, d = str(item).partition(":")
            if not key or d not in ("BUY", "SELL"):
                continue
            prev = last_seen.get((key, d))
            last_seen[(key, d)] = t
            if prev is not None and (t - prev).total_seconds() <= EPISODE_GAP_MIN * 60:
                continue                              # same episode, already counted at its first candle
            y = s.get("y")
            if not y or y.get("f25") not in ("UP", "DN"):
                continue
            win = (d == "BUY" and y["f25"] == "UP") or (d == "SELL" and y["f25"] == "DN")
            e = acc.setdefault(key, {"n": 0, "wins": 0, "exp": 0.0})
            e["n"] += 1
            e["wins"] += 1 if win else 0
            e["exp"] += up_d if d == "BUY" else (1 - up_d)
    out = {}
    for key, e in acc.items():
        if e["n"] < STRAT_MIN_EPISODES:
            continue
        excess = (e["wins"] - e["exp"]) / (e["n"] + STRAT_SHRINK_K)         # shrunk edge over a random candle
        out[key] = {"samples": e["n"], "wins": e["wins"], "raw_win_rate": round(100 * e["wins"] / e["n"], 1),
                    "expected_win_rate": round(100 * e["exp"] / e["n"], 1), "win_rate": round(50 + 100 * excess, 1)}
    return out


def strategy_stats(snaps=None):
    """{strategy_key: {'samples','win_rate'(50 = no better than a random candle),...}} -- shape strategy_engine already consumes."""
    try:
        if not ENABLED:
            return {}
        snaps = snaps if snaps is not None else mm.load_snapshots()
        key = (len(snaps), snaps[-1]["ts"] if snaps else "", sum(1 for s in snaps if s.get("y")))
        if _strat_cache["key"] == key:
            return _strat_cache["val"]
        val = _compute_strategy_stats(snaps)
        _strat_cache.update({"key": key, "val": val})
        return val
    except Exception:
        logger.exception("strategy_stats failed (ignored)")
        return {}


# ----------------------------------------------------------------------------- 3. engine adjustment (earned, bounded)
def update_state(fc, pstats, pbase, active, score):
    _STATE.update({"fc": fc, "pstats": {p["key"]: p for p in (pstats or [])}, "pbase": pbase or {}, "active": list(active or []),
                   "score": score or {}, "ts": time.time()})


def adjustment_status():
    """Plain-language: is each nudge currently earned?"""
    fc, sc = _STATE.get("fc") or {}, _STATE.get("score") or {}
    fc_ok = bool(fc.get("ready") and fc.get("trusted") and sc.get("n_trusted", 0) >= FC_MIN_LIVE_N and (sc.get("acc_trusted") or 0) >= FC_MIN_ACC)
    return {"engine_adjust": ENGINE_ADJUST if ENABLED else "off", "forecaster_earned": fc_ok,
            "fc_live_n": sc.get("n_trusted", 0), "fc_live_acc": sc.get("acc_trusted"),
            "patterns_with_enough_samples": sum(1 for p in (_STATE.get("pstats") or {}).values() if p["n"] / PAT_OVERLAP >= PAT_MIN_EFF_N)}


def engine_adjustment(direction):
    """-> {'delta_logit': +supports / -against the proposed trade, 'active': bool, 'note': str}.  Inert (0.0) unless earned."""
    out = {"delta_logit": 0.0, "active": False, "note": ""}
    try:
        if not ENABLED or ENGINE_ADJUST != "auto":
            return out
        d = str(direction).upper()
        if d not in ("BUY", "SELL") or time.time() - float(_STATE.get("ts") or 0) > 900:
            return out                                      # no fresh brain state -> do nothing
        fc, sc = _STATE.get("fc") or {}, _STATE.get("score") or {}
        total, notes = 0.0, []
        if fc.get("ready") and fc.get("trusted") and sc.get("n_trusted", 0) >= FC_MIN_LIVE_N and (sc.get("acc_trusted") or 0) >= FC_MIN_ACC:
            p = fc["p_up25"] if d == "BUY" else 1.0 - fc["p_up25"]
            adj = max(-FC_CAP, min(FC_CAP, (p - 0.5) * 0.8))
            total += adj
            notes.append(f"forecaster {p * 100:.0f}% ({adj:+.2f})")
        base = _STATE.get("pbase") or {}
        bd = base.get("up") if d == "BUY" else base.get("dn")
        if bd is not None:
            padj = 0.0
            for k in _STATE.get("active") or []:
                st = (_STATE.get("pstats") or {}).get(k)
                if not st or st["n"] / PAT_OVERLAP < PAT_MIN_EFF_N:
                    continue
                n_eff = st["n"] / PAT_OVERLAP
                rate = st["up"] if d == "BUY" else st["dn"]
                lo, hi = wilson(rate * n_eff, n_eff, PAT_Z)
                if lo > bd + 0.03:
                    padj += PAT_BONUS
                    notes.append(f"pattern '{st['text'][:40]}' supports ({rate * 100:.0f}% vs {bd * 100:.0f}% base, n={st['n']})")
                elif hi < bd - 0.03:
                    padj -= PAT_PENALTY
                    notes.append(f"pattern '{st['text'][:40]}' against ({rate * 100:.0f}% vs {bd * 100:.0f}% base, n={st['n']})")
            total += max(-0.10, min(0.10, padj))
        total = max(-TOTAL_CAP, min(TOTAL_CAP, total))
        out.update({"delta_logit": round(total, 3), "active": bool(notes), "note": "; ".join(notes)})
    except Exception:
        logger.exception("engine_adjustment failed (ignored)")
        return {"delta_logit": 0.0, "active": False, "note": ""}
    return out


# ----------------------------------------------------------------------------- 2. Gemini memory + scorecard
def _is_gemini_approved(t):
    g = t.get("gemini") or {}
    return isinstance(g, dict) and (g.get("reviewer") == "GEMINI" or g.get("status") == "APPROVED")


def gemini_scorecard(trades, shadow_by_gate=None):
    appr = [t for t in (trades or []) if _is_gemini_approved(t) and t.get("status") in ("WIN", "LOSS")]
    w = sum(1 for t in appr if t.get("status") == "WIN")
    rej = {}
    for gate, e in (shadow_by_gate or {}).items():
        if "gemini" in str(gate).lower() and e.get("n"):
            rej[gate] = e
    rn = sum(e["n"] for e in rej.values())
    rw = sum(e["wins"] for e in rej.values())
    by_model = {}
    for t in appr:
        m = str((t.get("gemini") or {}).get("model") or "?")
        e = by_model.setdefault(m, {"n": 0, "wins": 0})
        e["n"] += 1
        e["wins"] += int(t.get("status") == "WIN")
    return {"by_model": by_model, "approved_n": len(appr), "approved_wins": w, "approved_wr": (w / len(appr)) if appr else None,
            "rejected_n": rn, "rejected_would_win": rw, "rejected_wr": (rw / rn) if rn else None}


def gemini_context(res, trades, gem_sc, strat):
    """Short English memory block for Gemini's review prompt (advisory)."""
    lines = []
    try:
        done = [t for t in (trades or []) if t.get("status") in ("WIN", "LOSS")][:10]
        if done:
            lines.append(f"- Engine's last {len(done)} resolved trades: {sum(1 for t in done if t['status'] == 'WIN')} wins / "
                         f"{sum(1 for t in done if t['status'] == 'LOSS')} losses. Most recent: "
                         + ", ".join(f"{t.get('direction')} {t.get('status')}" for t in done[:5]) + ".")
        if gem_sc.get("approved_n"):
            lines.append(f"- Your past approvals: {gem_sc['approved_wins']}/{gem_sc['approved_n']} won ({100 * gem_sc['approved_wr']:.0f}%)."
                         + (f" Setups you rejected would have won {gem_sc['rejected_would_win']}/{gem_sc['rejected_n']} times." if gem_sc.get("rejected_n") else "")
                         + " Be strict about chasing and extended entries if approvals are losing.")
        pst = {p["key"]: p for p in (res.get("pstats") or [])}
        act = (res.get("fc") or {}).get("patterns") or []
        for k in act[:3]:
            p = pst.get(k)
            if p:
                lines.append(f"- Active pattern now: {p['text']} -> within 60 min price touched +25 first {100 * p['up']:.0f}% / -25 first {100 * p['dn']:.0f}% (n={p['n']}).")
        fc = res.get("fc") or {}
        if fc.get("ready"):
            lines.append(f"- Statistical forecaster: lean {fc.get('lean')}, P(+25 first)={100 * fc['p_up25']:.0f}% "
                         f"({'validated' if fc.get('trusted') else 'NOT validated -- treat as weak information'}).")
        good = sorted(((k, v) for k, v in (strat or {}).items() if v["win_rate"] >= 55), key=lambda z: -z[1]["win_rate"])[:2]
        bad = sorted(((k, v) for k, v in (strat or {}).items() if v["win_rate"] <= 45), key=lambda z: z[1]["win_rate"])[:2]
        if good or bad:
            lines.append("- Strategy track record (live): " + "; ".join([f"{k} strong ({v['wins']}/{v['samples']})" for k, v in good] +
                                                                       [f"{k} weak ({v['wins']}/{v['samples']})" for k, v in bad]) + ".")
        L = res.get("lessons") or {}
        if L.get("majors"):
            lines.append(f"- Engine caught {L['caught']} of {L['majors']} big (50+ pt) moves seen so far.")
    except Exception:
        logger.exception("gemini_context failed (ignored)")
    return "\n".join(lines)[:GEMINI_TEXT_MAX]


def publish_gemini_text(text):
    """Hand the block to ai_trade_decision's review prompt (a plain module variable; read in the background review thread)."""
    try:
        import ai_trade_decision
        ai_trade_decision.LEARNED_CONTEXT_TEXT = text or ""
    except Exception:
        logger.exception("publish_gemini_text failed (ignored)")


# ----------------------------------------------------------------------------- 4. daily upgrade log + suggestions
def daily_metrics(res, trades, day):
    rep = ((res.get("fc") or {}).get("reports") or {}).get("dir25") or {}
    sc = res.get("score") or {}
    todays = [t for t in (trades or []) if str(t.get("timestamp") or "")[:10] == day and t.get("status") in ("WIN", "LOSS")]
    L = res.get("lessons") or {}
    return {"day": day, "lab_n": res.get("lab_n"), "live_n": res.get("live_n"),
            "fc_trusted": bool((res.get("fc") or {}).get("trusted")), "fc_auc": rep.get("val_auc"), "fc_acc": rep.get("val_acc"),
            "fc_base": rep.get("val_base_acc"), "live_n_scored": sc.get("n"), "live_acc": sc.get("acc"),
            "patterns": len(res.get("pstats") or []), "strategies_scored": len(strategy_stats()),
            "engine_w": sum(1 for t in todays if t["status"] == "WIN"), "engine_l": sum(1 for t in todays if t["status"] == "LOSS"),
            "majors": L.get("majors"), "caught": L.get("caught")}


def save_daily_metrics(m, force=False):
    try:
        if not m or not m.get("day"):
            return
        if not force and time.time() - _last_metrics_save["t"] < 900:
            return
        mm.save_day("stats-" + m["day"], m)
        _last_metrics_save["t"] = time.time()
    except Exception:
        logger.exception("save_daily_metrics failed (ignored)")


def suggestions(res, shadow_by_gate=None, strat=None):
    """Plain-language observations.  NEVER applied automatically."""
    out = []
    try:
        for gate, e in (shadow_by_gate or {}).items():
            if e.get("n", 0) >= 8 and e.get("win_rate") is not None:
                if e["win_rate"] >= 60:
                    out.append(f"'{gate}' gate ne {e['n']} setups roke, {e['win_rate']:.0f}% jeet jaate -- ye gate shayad zyada sakht hai.")
                elif e["win_rate"] <= 35:
                    out.append(f"'{gate}' gate sahi kaam kar raha hai: {e['n']} roke setups me sirf {e['win_rate']:.0f}% jeete.")
        for k, v in (strat or {}).items():
            if v["win_rate"] <= 42:
                out.append(f"Strategy '{k}' live me kamzor: {v['wins']}/{v['samples']} baar sahi disha. Uska score apne aap kam hota hai.")
            elif v["win_rate"] >= 58:
                out.append(f"Strategy '{k}' live me achhi: {v['wins']}/{v['samples']} baar sahi disha.")
        ps = {p["key"]: p for p in (res.get("pstats") or [])}
        base = res.get("pbase") or {}
        for key, side in (("at_day_low_after_fall", "SELL"), ("at_day_high_after_rise", "BUY")):
            p = ps.get(key)
            if p and base:
                mine = p["dn"] if side == "SELL" else p["up"]
                b = base["dn"] if side == "SELL" else base["up"]
                out.append(f"Chase check: {p['text']} ke baad {side} disha me +25 pehle sirf {100 * mine:.0f}% (normal {100 * b:.0f}%, n={p['n']}).")
        fc = res.get("fc") or {}
        if fc.get("ready") and not fc.get("trusted"):
            out.append("Forecaster abhi baseline se behtar sabit nahi hua, isliye engine ko koi nudge nahi mil raha.")
    except Exception:
        logger.exception("suggestions failed (ignored)")
    return out[:12]
# @@END market_adaptive
# @@MODULE market_autopsy
"""
market_autopsy.py -- "market kahan se palta, kyon palta" (v46, purely additive).

For one trading day: finds every swing (zig-zag on the 5-min highs/lows), and for each REVERSAL point lists the data-visible
reasons around it: stop-hunt wick through the day's/previous day's extreme, volume spike, RSI / EMA stretch, strong reaction candle,
OI wall (live data), VWAP, round number, opening range ...  It also checks which big moves the trade engine caught or missed.

HONESTY  The reasons are what the DATA shows around the turn -- strong hints, not proof.  News / big-player orders that are not in
         the data cannot be seen; then the autopsy says so instead of inventing a story.
"""
from __future__ import annotations

import logging
import math

import numpy as np
import pandas as pd

import market_memory as mm

logger = logging.getLogger(__name__)

MIN_LEG_PTS = 35.0        # smallest swing the zig-zag reports
MAJOR_LEG_PTS = 50.0      # a "major" move (the size the user cares about)
TOP_CAUSES = 4


def _v(F, col, i):
    try:
        x = float(F[col].iloc[i])
        return None if math.isnan(x) else x
    except Exception:
        return None


def zigzag(h, l, thr):
    """[(bar_index, price, 'H'|'L')] -- confirmed pivots (a move of >= thr against the last extreme).  The still-running last
    extreme is appended as a provisional pivot."""
    n = len(h)
    piv, d = [], 0
    hi, hi_i, lo, lo_i = h[0], 0, l[0], 0
    ext = ext_i = None
    for i in range(n):
        if d == 0:
            if h[i] > hi:
                hi, hi_i = h[i], i
            if l[i] < lo:
                lo, lo_i = l[i], i
            if hi - lo >= thr:                      # whichever extreme came FIRST is the first pivot
                if hi_i < lo_i:
                    piv.append((hi_i, hi, "H"))
                    d, ext, ext_i = -1, lo, lo_i
                elif lo_i < hi_i:
                    piv.append((lo_i, lo, "L"))
                    d, ext, ext_i = 1, hi, hi_i
        elif d == 1:
            if h[i] > ext:
                ext, ext_i = h[i], i
            elif ext - l[i] >= thr:
                piv.append((ext_i, ext, "H"))
                d, ext, ext_i = -1, l[i], i
        else:
            if l[i] < ext:
                ext, ext_i = l[i], i
            elif h[i] - ext >= thr:
                piv.append((ext_i, ext, "L"))
                d, ext, ext_i = 1, h[i], i
    if d != 0 and ext_i is not None and (not piv or piv[-1][0] != ext_i):
        piv.append((ext_i, ext, "H" if d == 1 else "L"))
    return piv


def explain_pivot(d, F, p, kind, snap=None):
    """Data-visible reasons for the turn at bar p.  kind 'H' = a top (price then fell), 'L' = a bottom (price then rose).
    -> [(weight, key, Hinglish text)] strongest first."""
    out = []
    top = kind == "H"
    n = len(d)
    h, l, c = d["High"].values, d["Low"].values, d["Close"].values
    nxt = min(p + 1, n - 1)
    atr = _v(F, "atr", p) or 12.0
    side_wick = _v(F, "upper_wick" if top else "lower_wick", p)
    rng_atr = _v(F, "range_atr", p)
    prior = slice(0, p)
    if top:
        new_ext = p > 0 and h[p] >= (h[prior].max() if p > 0 else h[p])
        pd_lvl = _v(F, "dist_pdh_atr", p)
    else:
        new_ext = p > 0 and l[p] <= (l[prior].min() if p > 0 else l[p])
        pd_lvl = _v(F, "dist_pdl_atr", p)

    if new_ext and side_wick is not None and side_wick >= 0.4:
        out.append((3, "sweep", "Din ka naya %s bana kar wapas aaya (stop-hunt / liquidity sweep)" % ("high" if top else "low")))
    elif side_wick is not None and side_wick >= 0.5 and (rng_atr or 0) >= 0.8:
        out.append((2, "wick", "Lambi %s wick: %s ne price ko wapas dhakela" % ("upar ki" if top else "neeche ki", "sellers" if top else "buyers")))
    if pd_lvl is not None and abs(pd_lvl) <= 0.7:
        out.append((2, "prev_day", "Pichle din ke %s ke paas ruka" % ("high" if top else "low")))
    rsi = _v(F, "rsi", p)
    if rsi is not None and ((top and rsi >= 68) or (not top and rsi <= 32)):
        out.append((2, "rsi", "RSI %s (%.0f) -- move thak chuka tha" % ("overbought" if top else "oversold", rsi)))
    st = _v(F, "ema20_dist_atr", p)
    if st is not None and ((top and st >= 1.8) or (not top and st <= -1.8)):
        out.append((2, "stretch", "Price EMA20 se %.1f ATR %s khicha hua tha" % (abs(st), "upar" if top else "neeche")))
    vr = max([x for x in (_v(F, "vol_ratio", p), _v(F, "vol_ratio", nxt)) if x is not None] or [1.0])
    if vr >= 1.8:
        out.append((2, "volume", "Volume spike (%.1fx normal) turn ke aas-paas" % vr))
    ca, ra = _v(F, "candle_atr", nxt), _v(F, "range_atr", nxt)
    if ca is not None and ((top and ca <= -0.8) or (not top and ca >= 0.8) or (ra and ra >= 1.5 and ((top and ca < 0) or (not top and ca > 0)))):
        out.append((3, "reaction", "Agli candle me tez ulta move (turn ki confirmation)"))
    vw = _v(F, "vwap_dist_atr", p)
    if vw is not None and abs(vw) <= 0.35:
        out.append((2, "vwap", "VWAP ke paas rejection"))
    r50 = _v(F, "round50_dist", p)
    if r50 is not None and r50 <= 6:
        out.append((1, "round", "50 ke round number ke paas"))
    mins = _v(F, "mins_since_open", p)
    if mins is not None and mins <= 30:
        out.append((1, "opening", "Opening ke pehle 30 min ki volatility"))
    # LIVE-only context (option chain / PCR) -- only when that candle was recorded live
    if snap:
        wall = snap.get("call_wall" if top else "put_wall")
        if wall is not None:
            px = h[p] if top else l[p]
            if abs(float(wall) - px) <= 15:
                out.append((3, "oi_wall", "%s OI wall %.0f ke paas -- writers ne roka" % ("Call" if top else "Put", float(wall))))
    out.sort(key=lambda z: -z[0])
    return out


def _ctx_line(snap):
    if not snap:
        return "OI/PCR/global ka data us waqt record nahi tha (sirf price-based kaaran dikha sakte hain)"
    bits = []
    for k, lab, fmt in (("pcr", "PCR", "%.2f"), ("vix", "VIX", "%.1f"), ("global_avg", "global avg", "%+.2f%%"), ("breadth_net", "breadth", "%+.2f")):
        if snap.get(k) is not None:
            bits.append(lab + " " + fmt % snap[k])
    return ", ".join(bits) if bits else ""


def analyze_day(d, F, day, snaps_by_ts=None, trades=None):
    """d, F = prepared candles / features for ONE day (bars in order).  -> summary dict."""
    snaps_by_ts = snaps_by_ts or {}
    n = len(d)
    if n < 12:
        return None
    h, l, c, o = d["High"].values, d["Low"].values, d["Close"].values, d["Open"].values
    atr_med = float(np.nanmedian(d["ATR"].values))
    thr = max(MIN_LEG_PTS, 2.5 * atr_med)
    piv = zigzag(h, l, thr)
    legs = []
    for a, b in zip(piv[:-1], piv[1:]):
        pts = abs(b[1] - a[1])
        if pts < thr:
            continue
        kind_start = a[2]
        snap = snaps_by_ts.get(mm.ts_str(d.index[a[0]]))
        causes = explain_pivot(d, F, a[0], kind_start, snap)
        legs.append({
            "dir": "UP" if kind_start == "L" else "DOWN",
            "start": mm.ts_str(d.index[a[0]])[11:16], "end": mm.ts_str(d.index[b[0]])[11:16],
            "from": round(float(a[1]), 1), "to": round(float(b[1]), 1), "pts": round(float(pts), 1), "bars": int(b[0] - a[0]),
            "major": bool(pts >= MAJOR_LEG_PTS),
            "causes": [{"key": k, "text": t, "w": w} for w, k, t in causes[:TOP_CAUSES]],
            "context": _ctx_line(snap),
            "start_ts": mm.ts_str(d.index[a[0]]), "end_ts": mm.ts_str(d.index[b[0]]),
        })
    # which of those moves did the engine catch?
    for lg in legs:
        got = []
        for t in (trades or []):
            ts = str(t.get("timestamp") or "")[:19]
            want = "BUY" if lg["dir"] == "UP" else "SELL"
            if t.get("direction") == want and lg["start_ts"] <= ts <= lg["end_ts"]:
                got.append(f"{ts[11:16]} {t.get('direction')} ({t.get('status')})")
        lg["engine"] = got
    major = [x for x in legs if x["major"]]
    last_close = float(c[-1])
    summary = {
        "day": day, "open": round(float(o[0]), 1), "high": round(float(h.max()), 1), "low": round(float(l.min()), 1), "close": round(last_close, 1),
        "range": round(float(h.max() - l.min()), 1), "change": round(last_close - float(o[0]), 1), "bars": int(n),
        "thr": round(thr, 1), "legs": legs,
        "n_major": len(major), "n_major_caught": sum(1 for x in major if x["engine"]),
        "complete": bool(d.index[-1].time() >= mm.dtime(15, 25)),
    }
    return summary


def analyze_all(df, snaps=None, trades=None, now_day=None):
    """Autopsy of every day present in the candles.  -> {day: summary}.  Today's is marked complete=False until the close."""
    out = {}
    try:
        d = mm.prep(df)
        if d is None:
            return out
        F = mm.compute_features(d)
        by_ts = {s["ts"]: s["f"] for s in (snaps or [])}
        for day, idx in d.groupby(d.index.normalize()).indices.items():
            sub, fsub = d.iloc[idx], F.iloc[idx]
            s = analyze_day(sub, fsub, str(pd.Timestamp(day).date()), by_ts, trades)
            if s:
                out[s["day"]] = s
    except Exception:
        logger.exception("autopsy failed (ignored)")
    return out


def lessons(summaries):
    """Across days: which reasons show up most often behind major (>=50 pt) reversals, and how many majors the engine caught."""
    tot, caught = 0, 0
    cnt: dict = {}
    for s in summaries:
        for lg in s.get("legs", []):
            if not lg.get("major"):
                continue
            tot += 1
            caught += 1 if lg.get("engine") else 0
            for cz in lg.get("causes", []):
                cnt[cz["key"]] = cnt.get(cz["key"], 0) + 1
    rank = sorted(cnt.items(), key=lambda z: -z[1])
    return {"majors": tot, "caught": caught, "ranking": rank}


CAUSE_NAMES = {"sweep": "Stop-hunt / sweep", "wick": "Lambi rejection wick", "prev_day": "Pichle din ka high/low", "rsi": "RSI extreme",
               "stretch": "EMA se khicha hua", "volume": "Volume spike", "reaction": "Tez ulta candle", "vwap": "VWAP rejection",
               "round": "Round number", "opening": "Opening volatility", "oi_wall": "OI wall"}
# @@END market_autopsy
# @@MODULE market_learner
"""
market_learner.py -- what the recorded market teaches (v46, purely additive, ADVISORY only).

1. PATTERN MEMORY  ~20 named situations ("naya day-low bana kar neeche wick", "RSI oversold + volume spike" ...).  For every
   one we count, from the recorded candles, what price did in the next 60 min: +25 pts first / -25 pts first / neither.  So the
   system knows, from DATA, which situations really lead to a bounce / a fall and which are noise.
2. FORECASTER  a small logistic-regression + neural-network ensemble that reads the whole feature row and answers
       * P(price touches +25 before -25)           ("dir25")
       * P(+50 before -50, if a 50 pt move comes)  ("dir50")
       * P(a 50-pt move happens at all in 60 min)  ("mv50")
   Every model is WALK-FORWARD tested: trained on the older 75% of the days, scored on the newest 25% it never saw.  It is only
   marked TRUSTED when it beats the "always guess the majority" baseline there.  Untrusted = shown as information, never as advice.
3. SCORECARD  forecasts made LIVE are stored with the candle; once the outcome is known they are scored for real.

Nothing here opens, blocks or changes a trade (FORECAST_GATE stays "off" until the scorecard proves it).
"""
from __future__ import annotations

import logging
import math
import warnings

import numpy as np

import market_memory as mm

logger = logging.getLogger(__name__)

FORECAST_GATE = "off"          # "off" = advisory only.  (A later version can switch this to "soft" once the live scorecard is good.)
MIN_ROWS = {"dir25": 80, "dir50": 60, "mv50": 100}
MIN_VAL = 120                  # test rows (all folds together) needed before a model may be called trusted
TRUST_AUC = 0.58               # mean AUC over the folds
TRUST_MIN_FOLD_AUC = 0.52      # ... and even the worst fold must be above chance
TRUST_ACC_EDGE = 0.02
PATTERN_MIN_N = 12
EXT_MIN_ROWS = 150


def _g(f, k):
    v = f.get(k)
    try:
        v = float(v)
        return v if not math.isnan(v) else float("nan")
    except Exception:
        return float("nan")


# ----------------------------------------------------------------------------- 1. patterns
# (key, Hinglish label, side hint, condition(f))   side hint: "UP" = usually a bullish situation, "DN" = bearish, "-" = neutral
PATTERNS = [
    ("sweep_low", "Naya day-low bana kar neeche lambi wick (stop-hunt)", "UP",
     lambda f: _g(f, "lower_wick") >= 0.5 and _g(f, "range_atr") >= 1.0 and _g(f, "dist_daylow_atr") <= 0.3),
    ("sweep_high", "Naya day-high bana kar upar lambi wick (stop-hunt)", "DN",
     lambda f: _g(f, "upper_wick") >= 0.5 and _g(f, "range_atr") >= 1.0 and _g(f, "dist_dayhigh_atr") <= 0.3),
    ("at_day_low_after_fall", "Din ke low par, din bhar ~0.6%+ gira hua", "-",
     lambda f: _g(f, "day_pos") <= 0.12 and _g(f, "day_move_pct") <= -0.6),
    ("at_day_high_after_rise", "Din ke high par, din bhar ~0.6%+ chadha hua", "-",
     lambda f: _g(f, "day_pos") >= 0.88 and _g(f, "day_move_pct") >= 0.6),
    ("rsi_oversold", "RSI 30 ya neeche", "UP", lambda f: _g(f, "rsi") <= 30),
    ("rsi_overbought", "RSI 70 ya upar", "DN", lambda f: _g(f, "rsi") >= 70),
    ("stretched_below_ema", "Price EMA20 se 2 ATR neeche (khicha hua)", "UP", lambda f: _g(f, "ema20_dist_atr") <= -2.0),
    ("stretched_above_ema", "Price EMA20 se 2 ATR upar (khicha hua)", "DN", lambda f: _g(f, "ema20_dist_atr") >= 2.0),
    ("vol_spike_green", "Volume spike + badi green candle", "UP", lambda f: _g(f, "vol_ratio") >= 1.8 and _g(f, "candle_atr") >= 0.8),
    ("vol_spike_red", "Volume spike + badi red candle", "DN", lambda f: _g(f, "vol_ratio") >= 1.8 and _g(f, "candle_atr") <= -0.8),
    ("above_vwap_trend", "VWAP aur EMA20 dono ke upar (uptrend)", "UP", lambda f: _g(f, "vwap_dist_atr") >= 0.5 and _g(f, "ema20_dist_atr") > 0),
    ("below_vwap_trend", "VWAP aur EMA20 dono ke neeche (downtrend)", "DN", lambda f: _g(f, "vwap_dist_atr") <= -0.5 and _g(f, "ema20_dist_atr") < 0),
    ("orb_breakout_up", "Opening range ke upar", "UP", lambda f: _g(f, "or_pos") == 1.0),
    ("orb_breakdown", "Opening range ke neeche", "DN", lambda f: _g(f, "or_pos") == -1.0),
    ("round_number", "50 ke round number ke bilkul paas", "-", lambda f: _g(f, "round50_dist") <= 6),
    ("streak_red4", "Lagatar 4+ red candles", "-", lambda f: _g(f, "streak") <= -4),
    ("streak_green4", "Lagatar 4+ green candles", "-", lambda f: _g(f, "streak") >= 4),
    ("late_session", "Din ka aakhri hissa (13:45 ke baad)", "-", lambda f: _g(f, "mins_since_open") >= 270),
    ("prev_day_high_zone", "Pichle din ke high ke 0.5 ATR ke andar", "DN", lambda f: abs(_g(f, "dist_pdh_atr")) <= 0.5),
    ("prev_day_low_zone", "Pichle din ke low ke 0.5 ATR ke andar", "UP", lambda f: abs(_g(f, "dist_pdl_atr")) <= 0.5),
    ("at_put_wall", "Put OI wall ke bilkul paas (live data)", "UP", lambda f: -12 <= _g(f, "put_wall_dist") <= 6 and _g(f, "put_wall_share") >= 0.6),
    ("at_call_wall", "Call OI wall ke bilkul paas (live data)", "DN", lambda f: -6 <= _g(f, "call_wall_dist") <= 12 and _g(f, "call_wall_share") >= 0.6),
]
_PAT_LABEL = {k: t for k, t, _s, _fn in PATTERNS}


def pattern_label(key):
    return _PAT_LABEL.get(key, key)


def active_patterns(f: dict):
    out = []
    for k, _t, _s, fn in PATTERNS:
        try:
            if fn(f):
                out.append(k)
        except Exception:
            pass
    return out


def _decided(snaps, level="f25"):
    return [s for s in snaps if s.get("y") and s["y"].get(level) in ("UP", "DN", "NONE")]


def pattern_stats(snaps, level="f25"):
    """[{key,text,hint,n,up,dn,none,lift_up,lift_dn}] for patterns with enough samples, strongest edge first."""
    rows = _decided(snaps, level)
    if not rows:
        return [], {}
    tot = len(rows)
    base = {"up": sum(1 for s in rows if s["y"][level] == "UP") / tot, "dn": sum(1 for s in rows if s["y"][level] == "DN") / tot, "n": tot}
    acc = {k: [0, 0, 0, 0] for k, *_ in PATTERNS}     # n, up, dn, none
    for s in rows:
        for k in active_patterns(s["f"]):
            a = acc[k]
            a[0] += 1
            a[1 if s["y"][level] == "UP" else 2 if s["y"][level] == "DN" else 3] += 1
    out = []
    for k, text, hint, _fn in PATTERNS:
        n, u, dn, no = acc[k]
        if n < PATTERN_MIN_N:
            continue
        out.append({"key": k, "text": text, "hint": hint, "n": n, "up": u / n, "dn": dn / n, "none": no / n,
                    "lift_up": u / n - base["up"], "lift_dn": dn / n - base["dn"]})
    out.sort(key=lambda z: -max(abs(z["lift_up"]), abs(z["lift_dn"])))
    return out, base


# ----------------------------------------------------------------------------- 2. forecaster
def _matrix(rows, feats):
    X = np.array([[_g(s["f"], k) for k in feats] for s in rows], dtype=float)
    return X


def _impute_fit(X):
    med = np.nanmedian(X, axis=0)
    med = np.where(np.isnan(med), 0.0, med)
    Xi = np.where(np.isnan(X), med, X)
    mu, sd = Xi.mean(0), Xi.std(0) + 1e-9
    return med, mu, sd


def _transform(X, pack):
    med, mu, sd = pack
    Xi = np.where(np.isnan(X), med, X)
    return np.clip((Xi - mu) / sd, -5, 5)


def _fit(X, y):
    from sklearn.linear_model import LogisticRegression
    from sklearn.neural_network import MLPClassifier
    pack = _impute_fit(X)
    Xs = _transform(X, pack)
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        lr = LogisticRegression(C=0.3, max_iter=600).fit(Xs, y)
        nn = MLPClassifier(hidden_layer_sizes=(12,), alpha=0.05, max_iter=400, random_state=7).fit(Xs, y)
    return {"pack": pack, "lr": lr, "nn": nn}


def _proba(m, X):
    Xs = _transform(X, m["pack"])
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        return 0.5 * m["lr"].predict_proba(Xs)[:, 1] + 0.5 * m["nn"].predict_proba(Xs)[:, 1]


def _target(rows, name):
    if name == "dir25":
        sel = [s for s in rows if s["y"].get("f25") in ("UP", "DN")]
        return sel, np.array([1 if s["y"]["f25"] == "UP" else 0 for s in sel])
    if name == "dir50":
        sel = [s for s in rows if s["y"].get("f50") in ("UP", "DN")]
        return sel, np.array([1 if s["y"]["f50"] == "UP" else 0 for s in sel])
    sel = [s for s in rows if s["y"].get("f50") in ("UP", "DN", "NONE", "AMB")]
    return sel, np.array([0 if s["y"]["f50"] == "NONE" else 1 for s in sel])


def _train_one(rows, name, feats):
    """-> (model|None, report).  Rolling-origin test: 3 expanding-window folds over the newest half of the data (each fold is trained
    only on the PAST, with a 12-candle purge gap because neighbouring candles share look-ahead), then a final refit on everything.
    Trusted only if the average AUC is clearly above chance, the WORST fold is still above chance, and accuracy beats the
    'always guess the training-set majority' baseline.  Neighbouring candles overlap, so the bar is deliberately strict."""
    sel, y = _target(rows, name)
    rep = {"n": len(sel), "need": MIN_ROWS[name], "trusted": False, "ready": False}
    if len(sel) < MIN_ROWS[name] or len(set(y.tolist())) < 2:
        return None, rep
    X = _matrix(sel, feats)
    n = len(sel)
    gap = 12
    try:
        from sklearn.metrics import roc_auc_score
        edges = [int(n * 0.5), int(n * 0.667), int(n * 0.833), n]
        P, Y, aucs, base_hits = [], [], [], []
        for a, b in zip(edges[:-1], edges[1:]):
            tr = slice(0, max(a - gap, 0))
            if a - gap < 40 or b - a < 10 or len(set(y[tr].tolist())) < 2 or len(set(y[a:b].tolist())) < 2:
                continue
            m0 = _fit(X[tr], y[tr])
            p = _proba(m0, X[a:b])
            maj = 1 if y[tr].mean() >= 0.5 else 0
            P += p.tolist()
            Y += y[a:b].tolist()
            aucs.append(float(roc_auc_score(y[a:b], p)))
            base_hits += [int(v == maj) for v in y[a:b]]
        if aucs:
            P, Y = np.array(P), np.array(Y)
            acc = float(((P >= 0.5) == (Y == 1)).mean())
            base = float(np.mean(base_hits))
            rep.update({"val_n": int(len(Y)), "val_acc": round(acc, 3), "val_base_acc": round(base, 3), "val_auc": round(float(np.mean(aucs)), 3),
                        "val_auc_min": round(float(np.min(aucs)), 3), "folds": len(aucs), "val_brier": round(float(((P - Y) ** 2).mean()), 4),
                        "trusted": bool(len(Y) >= MIN_VAL and len(aucs) >= 2 and np.mean(aucs) >= TRUST_AUC and np.min(aucs) >= TRUST_MIN_FOLD_AUC
                                        and acc >= base + TRUST_ACC_EDGE)})
        m = _fit(X, y)
        rep["ready"] = True
        return m, rep
    except Exception:
        logger.exception("forecaster training failed (ignored): %s", name)
        return None, rep


_MODELS: dict = {"key": None, "bundle": None, "running": False}


def _build(lab):
    bundle = {"n_labelled": len(lab), "base": {}, "ext": {}, "ext_n": 0}
    for name in MIN_ROWS:
        bundle["base"][name] = _train_one(lab, name, mm.BASE_FEATS)
    ext_rows = [s for s in lab if s["f"].get("pcr") is not None or s["f"].get("put_wall_dist") is not None or s["f"].get("call_wall_dist") is not None]
    bundle["ext_n"] = len(ext_rows)
    if len(ext_rows) >= EXT_MIN_ROWS:
        feats = mm.BASE_FEATS + mm.EXT_FEATS
        for name in MIN_ROWS:
            bundle["ext"][name] = _train_one(ext_rows, name, feats)
    return bundle


def train_all(snaps, block=False):
    """Train in a BACKGROUND thread (the 30-s page never waits) whenever ~10 more labelled candles exist.
    Returns the newest finished bundle, or None while the very first training is still running."""
    import threading
    lab = [s for s in snaps if s.get("y")][-3000:]     # newest 3000 labelled candles (~40 days) keep training fast
    key = (len(lab) // 10, (lab[-1]["ts"][:10] if lab else ""))
    if _MODELS["key"] == key and _MODELS["bundle"] is not None:
        return _MODELS["bundle"]
    if _MODELS["running"] and not block:
        return _MODELS["bundle"]

    def job():
        _MODELS["running"] = True
        try:
            _MODELS.update({"bundle": _build(lab), "key": key})
        except Exception:
            logger.exception("market_learner training job failed (ignored)")
        finally:
            _MODELS["running"] = False

    if block:
        job()
    else:
        threading.Thread(target=job, daemon=True).start()
    return _MODELS["bundle"]


def forecast(snaps, f_now: dict, block=False):
    """Forecast for the current feature row.  Always returns a dict; 'ready' False when there is too little data."""
    out = {"ready": False, "trusted": False, "lean": "NEUTRAL", "msg": "", "reports": {}}
    try:
        bundle = train_all(snaps, block=block)
        if bundle is None:
            out["msg"] = "Forecaster pehli baar seekh raha hai (background me chal raha hai) -- agle refresh par dikhega."
            return out
        out["n_labelled"] = bundle["n_labelled"]
        base_m, base_rep = bundle["base"]["dir25"]
        out["reports"] = {n: bundle["base"][n][1] for n in bundle["base"]}
        if base_m is None:
            out["msg"] = f"Data abhi kam hai: {base_rep['n']}/{base_rep['need']} labelled candles. Har naye candle ke saath seekhta rahega."
            return out
        # choose the model set: the extended one (OI/PCR/VIX/breadth ...) only if it validated better than the base one
        use = "base"
        sets = bundle["base"]
        ext = bundle["ext"].get("dir25") if bundle["ext"] else None
        if ext and ext[0] is not None and ext[1].get("trusted") and ext[1].get("val_auc", 0) >= base_rep.get("val_auc", 0):
            use, sets = "ext", bundle["ext"]
        feats = mm.BASE_FEATS + (mm.EXT_FEATS if use == "ext" else [])
        x = np.array([[_g(f_now, k) for k in feats]], dtype=float)
        res = {}
        for name in ("dir25", "dir50", "mv50"):
            m, rep = sets.get(name, (None, {}))
            if m is not None:
                res[name] = float(_proba(m, x)[0])
        out["ready"] = True
        out["model_used"] = use
        out["p_up25"] = res.get("dir25")
        out["p_up50"] = res.get("dir50")
        out["p_move50"] = res.get("mv50")
        out["trusted"] = bool(sets["dir25"][1].get("trusted"))
        out["reports"] = {n: sets[n][1] for n in sets}
        p = out["p_up25"]
        out["lean"] = "UP" if p >= 0.58 else "DOWN" if p <= 0.42 else "NEUTRAL"
        out["patterns"] = active_patterns(f_now)
        out["msg"] = ("Validated (naye, na dekhe hue data par is se behtar nikla)" if out["trusted"]
                      else "Abhi UNTRUSTED -- sirf jaankari, validation me baseline se behtar sabit nahi hua")
    except Exception:
        logger.exception("forecast failed (ignored)")
        out["msg"] = "forecast error (ignored)"
    return out


def trade_view(fc: dict, direction: str):
    """How does the forecast see a proposed BUY/SELL?  -> {'verdict': SUPPORTS|AGAINST|NEUTRAL|UNTRUSTED|NO_DATA, 'p_dir': float|None}"""
    if not fc or not fc.get("ready") or fc.get("p_up25") is None:
        return {"verdict": "NO_DATA", "p_dir": None}
    p = fc["p_up25"] if str(direction).upper() == "BUY" else 1.0 - fc["p_up25"]
    if not fc.get("trusted"):
        return {"verdict": "UNTRUSTED", "p_dir": p}
    return {"verdict": "SUPPORTS" if p >= 0.56 else "AGAINST" if p <= 0.44 else "NEUTRAL", "p_dir": p}


# ----------------------------------------------------------------------------- 3. live scorecard
def scorecard(snaps):
    """Real out-of-sample proof: forecasts stored LIVE vs what the market then did."""
    rows = [s for s in snaps if s.get("fc") and s.get("y") and s["fc"].get("p_up25") is not None and s["y"].get("f25") in ("UP", "DN")]
    if not rows:
        return {"n": 0}
    hits = [((s["fc"]["p_up25"] >= 0.5) == (s["y"]["f25"] == "UP")) for s in rows]
    conf = [(h, s) for h, s in zip(hits, rows) if abs(s["fc"]["p_up25"] - 0.5) >= 0.08]
    trusted = [h for h, s in zip(hits, rows) if s["fc"].get("trusted")]
    return {"n": len(rows), "acc": sum(hits) / len(hits),
            "n_conf": len(conf), "acc_conf": (sum(1 for h, _ in conf if h) / len(conf)) if conf else None,
            "n_trusted": len(trusted), "acc_trusted": (sum(trusted) / len(trusted)) if trusted else None}
# @@END market_learner
# @@MODULE consensus_engine
"""
consensus_engine.py -- v60: ONE place that counts how many of the tool's factors are BUYING, SELLING or NEUTRAL right now.

It reads what the dashboard has already computed (trend, VWAP/EMA/RSI/MACD, structure, S/R, option chain + OI, PCR, FII, order flow, breadth,
sectors, Bank Nifty + the 6 index banks, global markets, news, fundamentals, strategy engine, ML, AI engine) and adds two things that were missing:
  * BANK block  -- live move of the 6 index banks, Bank Nifty vs Nifty, bank FUNDAMENTALS (ROE / growth / margin / P/B, from Yahoo, cached 6 h)
                   and bank NEWS (Google News RSS).
  * a better news reader (word-boundary lexicon; the old keyword check matched "up" inside "update", "down" inside "download").

HOW THE WINNER IS CHOSEN (honest, not magic)
  * counts (BUY / SELL / NEUTRAL) are plain counts of factors.
  * the "strongest side" is NOT the raw count: correlated factors (RSI, MACD, EMA, VWAP ... all say the same thing) would out-shout everything.
    So every GROUP gets its own balanced edge (-1..+1) and the groups are averaged with group weights.  Edge >= 0.35 STRONG, >= 0.18 MODERATE,
    >= 0.08 WEAK, else BALANCED (no clear side -> sit out).
  * a missing source is "data nahi" (not counted as neutral); the data-coverage % is shown so you know how much to trust the reading.
  * this is evidence about what the data says NOW, not a prediction.  A session track-record (did the edge agree with price 15 min later) is
    kept so you can see for yourself whether it is useful.

Pure + defensive: every factor is computed inside its own try/except, nothing here can stop the dashboard.  `ENABLED = False` switches it off.
"""
import logging
import math
import re
import time
import urllib.parse
from concurrent.futures import ThreadPoolExecutor, wait as _wait

logger = logging.getLogger(__name__)

ENABLED = True

# group -> weight in the final edge (groups, not single factors, decide the winner: avoids double counting correlated indicators)
GROUP_W = {
    "Price & Trend": 1.5, "Structure & Levels": 1.5, "Options & OI": 1.2, "Flow & Breadth": 1.2, "Bank": 1.0,
    "Global": 1.0, "News": 0.7, "Fundamentals": 0.5, "Models": 1.3,
}
GROUP_ORDER = list(GROUP_W)

STRONG_EDGE, MODERATE_EDGE, WEAK_EDGE = 0.35, 0.18, 0.08

BANKS = ["HDFCBANK", "ICICIBANK", "SBIN", "KOTAKBANK", "AXISBANK", "INDUSINDBK"]
BANK_NAME = {"HDFCBANK": "HDFC Bank", "ICICIBANK": "ICICI Bank", "SBIN": "SBI", "KOTAKBANK": "Kotak Bank",
             "AXISBANK": "Axis Bank", "INDUSINDBK": "IndusInd Bank"}
_BANK_ALIASES = {"HDFCBANK": ("HDFCBANK", "HDFC BANK"), "ICICIBANK": ("ICICIBANK", "ICICI BANK"), "SBIN": ("SBIN", "SBI", "STATE BANK"),
                 "KOTAKBANK": ("KOTAKBANK", "KOTAK BANK", "KOTAK MAHINDRA"), "AXISBANK": ("AXISBANK", "AXIS BANK"),
                 "INDUSINDBK": ("INDUSINDBK", "INDUSIND BANK")}

BANK_FUND_TTL = 6 * 3600
_BANK_FUND_FAIL = {"ts": 0.0}


# ----------------------------------------------------------------------------------------------------------------------------------
# small helpers
# ----------------------------------------------------------------------------------------------------------------------------------
def _f(x):
    try:
        v = float(x)
        return v if math.isfinite(v) else None
    except Exception:
        return None


def _lean(text):
    """+1 / -1 / 0 from a text like 'BULLISH 🟢', 'BREAKDOWN LIKELY (bearish) 🔴', 'BUY'.  None when there is no usable text."""
    t = str(text or "").upper()
    if not t.strip() or any(k in t for k in ("UNAVAILABLE", "UNKNOWN", "N/A", "NO DATA", "DATA NAHI", "NOT ENOUGH")):
        return None
    if "BEAR" in t or t.strip() in ("SELL", "NEGATIVE") or t.startswith("SELL"):
        return -1
    if "BULL" in t or t.strip() in ("BUY", "POSITIVE") or t.startswith("BUY"):
        return 1
    return 0


def _sgn_pct(chg, dead):
    c = _f(chg)
    if c is None:
        return None
    return 1 if c > dead else -1 if c < -dead else 0


def _norm(s):
    return re.sub(r"[^A-Z0-9]", "", str(s or "").upper())


# ----------------------------------------------------------------------------------------------------------------------------------
# news reader
# ----------------------------------------------------------------------------------------------------------------------------------
_POS = ["surge", "surges", "surged", "jump", "jumps", "jumped", "gain", "gains", "gained", "rally", "rallies", "soar", "soars", "climb", "climbs",
        "rise", "rises", "rose", "rebound", "rebounds", "recover", "recovers", "recovery", "upgrade", "upgrades", "upgraded", "beat", "beats",
        "strong", "stronger", "boost", "boosts", "optimism", "optimistic", "bullish", "inflow", "inflows", "buying", "buyers", "outperform",
        "outperforms", "record high", "all-time high", "rate cut", "rate cuts", "ceasefire", "trade deal", "peace", "stimulus", "profit jumps",
        "net buyers", "positive", "growth", "expands", "approval", "approved", "relief"]
_NEG = ["fall", "falls", "fell", "drop", "drops", "dropped", "dip", "dips", "slump", "slumps", "crash", "crashes", "plunge", "plunges",
        "tumble", "tumbles", "sink", "sinks", "slide", "slides", "decline", "declines", "loss", "losses", "sell-off", "selloff", "selling",
        "sellers", "outflow", "outflows", "downgrade", "downgrades", "downgraded", "miss", "misses", "weak", "weaker", "weakness", "fear", "fears",
        "worry", "worries", "concern", "concerns", "tension", "tensions", "war", "strike", "sanction", "sanctions", "tariff", "tariffs",
        "inflation", "default", "fraud", "probe", "penalty", "fine", "bearish", "pressure", "rate hike", "rate hikes", "net sellers",
        "profit booking", "job cuts", "slowdown", "recession", "volatile", "negative", "warns", "warning", "risk", "risks", "bad loans", "npa"]


def _compile(words):
    # longest first so "rate cut" wins over "cut"; word boundaries so "up" can never match inside "update"
    ws = sorted(set(words), key=len, reverse=True)
    return re.compile(r"(?<![a-z0-9])(?:" + "|".join(re.escape(w) for w in ws) + r")(?![a-z0-9])", re.I)


_POS_RE, _NEG_RE = _compile(_POS), _compile(_NEG)


def _clean_title(t):
    t = re.sub(r"\s+", " ", str(t or "")).strip()
    return re.sub(r"\s+-\s+[^-]{2,40}$", "", t)          # Google News adds " - Source name"


def news_score(titles):
    """-> {label, pos, neg, n, headline, headlines}.  label BULLISH / BEARISH / NEUTRAL / UNAVAILABLE.  Each headline counts once, by the
    sign of (positive words - negative words) in it."""
    titles = [_clean_title(t) for t in (titles or []) if str(t or "").strip()]
    if not titles:
        return {"label": "UNAVAILABLE", "pos": 0, "neg": 0, "n": 0, "headline": "", "headlines": []}
    pos = neg = 0
    for t in titles:
        d = len(_POS_RE.findall(t)) - len(_NEG_RE.findall(t))
        if d > 0:
            pos += 1
        elif d < 0:
            neg += 1
    scored = pos + neg
    diff = pos - neg
    if scored == 0:
        label = "NEUTRAL"
    elif diff >= 2 or (diff > 0 and diff / scored >= 0.34):
        label = "BULLISH"
    elif diff <= -2 or (diff < 0 and -diff / scored >= 0.34):
        label = "BEARISH"
    else:
        label = "NEUTRAL"
    return {"label": label, "pos": pos, "neg": neg, "n": len(titles), "headline": titles[0], "headlines": titles[:6]}


def _rss_titles(query, limit=10):
    import multi_stock_engine as _mse
    url = f"https://news.google.com/rss/search?q={urllib.parse.quote(query)}&hl=en-IN&gl=IN&ceid=IN:en"
    feed = _mse._cached_rss(url)
    return [e.get("title", "") for e in feed.entries[:limit]]


def fetch_bank_news():
    return _rss_titles("Bank Nifty banking stocks India RBI HDFC ICICI SBI", limit=10)


def fetch_nifty_news():
    return _rss_titles("NIFTY 50 NSE India stock market index news", limit=10)


def bank_news_result():
    return news_score(fetch_bank_news())


def nifty_news_result():
    return news_score(fetch_nifty_news())


# ----------------------------------------------------------------------------------------------------------------------------------
# bank fundamentals (outside data: Yahoo Finance, cached by safe_io.guarded for 6 h)
# ----------------------------------------------------------------------------------------------------------------------------------
def score_bank_fundamentals(info):
    """info: dict with returnOnEquity, earningsGrowth, revenueGrowth, profitMargins, priceToBook -> (score, label, notes). Missing = no point."""
    s, notes = 0, []
    roe, eg, rg, pm, pb = (_f(info.get(k)) for k in ("returnOnEquity", "earningsGrowth", "revenueGrowth", "profitMargins", "priceToBook"))
    if roe is not None:
        if roe >= 0.13:
            s += 1; notes.append(f"ROE {roe*100:.0f}%")
        elif roe < 0.09:
            s -= 1; notes.append(f"ROE low {roe*100:.0f}%")
    if eg is not None:
        if eg > 0.05:
            s += 1; notes.append(f"profit growth {eg*100:+.0f}%")
        elif eg < 0:
            s -= 1; notes.append(f"profit falling {eg*100:+.0f}%")
    if rg is not None:
        if rg > 0.05:
            s += 1; notes.append(f"revenue {rg*100:+.0f}%")
        elif rg < 0:
            s -= 1; notes.append(f"revenue {rg*100:+.0f}%")
    if pm is not None:
        if pm > 0.25:
            s += 1; notes.append(f"margin {pm*100:.0f}%")
        elif pm < 0.12:
            s -= 1; notes.append(f"margin low {pm*100:.0f}%")
    if pb is not None:
        if pb > 3.5:
            s -= 1; notes.append(f"P/B {pb:.1f} costly")
        elif pb <= 2.0:
            s += 1; notes.append(f"P/B {pb:.1f} cheap")
    have = sum(v is not None for v in (roe, eg, rg, pm, pb))
    if have < 3:
        return 0, "NA", notes
    return s, ("STRONG" if s >= 2 else "WEAK" if s <= -1 else "OK"), notes


def fetch_bank_fundamentals():
    """{symbol: {label, score, notes}}.  Raises when nothing could be read (so safe_io keeps the previous good value and retries later)."""
    if time.time() - _BANK_FUND_FAIL["ts"] < 600:
        raise RuntimeError("bank fundamentals: backing off after a failed fetch")
    import yfinance as yf

    def _one(sym):
        info = yf.Ticker(sym + ".NS").info or {}
        sc, label, notes = score_bank_fundamentals(info)
        return {"label": label, "score": sc, "notes": notes}

    ex = ThreadPoolExecutor(max_workers=6)
    futs = {s: ex.submit(_one, s) for s in BANKS}
    try:
        _wait(list(futs.values()), timeout=25)
    finally:
        ex.shutdown(wait=False, cancel_futures=True)
    out = {}
    for s, f in futs.items():
        try:
            if f.done():
                out[s] = f.result()
        except Exception:
            pass
    if not any(v.get("label") != "NA" for v in out.values()):
        _BANK_FUND_FAIL["ts"] = time.time()
        raise RuntimeError("bank fundamentals: no data returned")
    return out


def gather_outside(safe_io):
    """Outside data, never blocking the page for long: (bank_fund dict, bank_news dict|None, nifty_news dict|None).
    safe_io.guarded keeps the last good value and finishes slow fetches in the background."""
    bank_fund = safe_io.guarded("consensus_bank_fund", fetch_bank_fundamentals, timeout=2, ttl=BANK_FUND_TTL, default={})
    bank_news = safe_io.guarded("consensus_bank_news", bank_news_result, timeout=3, ttl=300, default=None)
    nifty_news = safe_io.guarded("consensus_nifty_news", nifty_news_result, timeout=3, ttl=300, default=None)
    return (bank_fund or {}), bank_news, nifty_news


# ----------------------------------------------------------------------------------------------------------------------------------
# the factor collector
# ----------------------------------------------------------------------------------------------------------------------------------
class _Board:
    def __init__(self):
        self.rows = []

    def add(self, group, name, vote, detail="", w=1.0):
        """vote: +1 BUY / -1 SELL / 0 NEUTRAL / None = no data."""
        try:
            v = None if vote is None else (1 if vote > 0 else -1 if vote < 0 else 0)
        except Exception:
            v = None
        self.rows.append({"group": group, "name": name, "vote": v, "detail": str(detail or ""), "w": float(w)})

    def safe(self, group, name, fn, w=1.0):
        """fn() -> (vote, detail).  Any error = 'no data' for that factor only."""
        try:
            vote, detail = fn()
        except Exception:
            logger.debug("consensus factor %s failed", name, exc_info=True)
            vote, detail = None, "data nahi"
        self.add(group, name, vote, detail, w)


def _bank_row_change(sym, df_full50, df_heavy):
    aliases = {_norm(a) for a in _BANK_ALIASES.get(sym, (sym,))}
    for df, col in ((df_full50, "Symbol"), (df_heavy, "Stock")):
        try:
            if df is None or getattr(df, "empty", True) or col not in df.columns or "Change (%)" not in df.columns:
                continue
            for _, r in df.iterrows():
                if _norm(r[col]) in aliases:
                    c = _f(r["Change (%)"])
                    if c is not None:
                        return c
        except Exception:
            continue
    return None


def _global_change(df, *needles):
    """average Change (%) of the global rows whose name contains one of the needles"""
    try:
        if df is None or getattr(df, "empty", True):
            return None
        col = "Global Market / Asset"
        vals = [_f(r["Change (%)"]) for _, r in df.iterrows() if any(n.lower() in str(r[col]).lower() for n in needles)]
        vals = [v for v in vals if v is not None]
        return sum(vals) / len(vals) if vals else None
    except Exception:
        return None


def build(ctx):
    """ctx: dict of what the dashboard already has (all optional).  Returns the consensus result dict (never raises)."""
    try:
        return _build(ctx or {})
    except Exception:
        logger.exception("consensus_engine failed (ignored)")
        return {"ok": False, "one_line": "Consensus abhi nahi bana (data error) -- baaki dashboard theek chal raha hai", "side": "NA", "factors": [],
                "buy": 0, "sell": 0, "neutral": 0, "na": 0, "total": 0, "line1": "", "line2": "", "line3": "", "summary_text": ""}


def _build(c):
    c = dict(c)
    c["index_corr"] = [r for r in (c.get("index_corr") if isinstance(c.get("index_corr"), (list, tuple)) else []) if isinstance(r, dict)]
    for k in ("ai_analysis", "strategy_result", "ml_results", "level_prediction", "sr_context", "regime", "mtf", "orb", "candle", "order_flow",
              "pcr_vel", "global_research", "bank_fund", "bank_news", "nifty_news"):
        if not isinstance(c.get(k), dict):
            c[k] = None
    B = _Board()
    px = _f(c.get("live_price"))
    atr = _f(c.get("atr")) or 15.0
    df = c.get("df")
    last = None
    try:
        if df is not None and not df.empty:
            last = df.iloc[-1]
    except Exception:
        last = None

    def L(key, default=None):
        try:
            return _f(last.get(key)) if last is not None else default
        except Exception:
            return default

    # ------------------------------------------------------------- PRICE & TREND
    G = "Price & Trend"

    def f_vwap():
        v = L("VWAP")
        if px is None or v is None:
            return None, "data nahi"
        d = (px - v) / atr
        return (1 if d >= 0.1 else -1 if d <= -0.1 else 0), f"price {px - v:+.0f} pts vs VWAP"
    B.safe(G, "Price vs VWAP", f_vwap)

    def f_ema():
        e20, e50 = L("EMA_20"), L("EMA_50")
        if px is None or e20 is None or e50 is None:
            return None, "data nahi"
        if px > e20 > e50:
            return 1, "price > EMA20 > EMA50"
        if px < e20 < e50:
            return -1, "price < EMA20 < EMA50"
        return 0, "EMAs mixed"
    B.safe(G, "EMA trend", f_ema)

    def f_rsi():
        r = L("RSI")
        if r is None:
            return None, "data nahi"
        if r > 72:
            return 0, f"RSI {r:.0f} overbought (thaka hua)"
        if r < 28:
            return 0, f"RSI {r:.0f} oversold (thaka hua)"
        return (1 if r >= 58 else -1 if r <= 42 else 0), f"RSI {r:.0f}"
    B.safe(G, "RSI", f_rsi)

    def f_macd():
        h = L("MACD_Hist")
        if h is None:
            m, s = L("MACD"), L("MACD_Signal")
            h = (m - s) if (m is not None and s is not None) else None
        if h is None:
            return None, "data nahi"
        return (1 if h > 0.5 else -1 if h < -0.5 else 0), f"MACD hist {h:+.1f}"
    B.safe(G, "MACD", f_macd)

    def f_mom():
        if df is None or len(df) < 8 or px is None:
            return None, "data nahi"
        past = _f(df["Close"].iloc[-7])
        if past is None:
            return None, "data nahi"
        d = (px - past) / atr
        return (1 if d >= 0.5 else -1 if d <= -0.5 else 0), f"pichhle 6 candle {px - past:+.0f} pts"
    B.safe(G, "Short momentum", f_mom)

    def f_poc():
        p = _f(c.get("live_poc"))
        if px is None or p is None:
            return None, "data nahi"
        d = (px - p) / atr
        return (1 if d >= 0.1 else -1 if d <= -0.1 else 0), f"price {px - p:+.0f} pts vs volume POC"
    B.safe(G, "Price vs POC", f_poc, w=0.8)

    def f_cpr():
        t = str(c.get("cpr_pos") or "").upper()
        if not t or "INSUFFICIENT" in t:
            return None, "data nahi"
        return (1 if t.startswith("ABOVE") else -1 if t.startswith("BELOW") else 0), t.split("(")[0].strip().title()
    B.safe(G, "CPR position", f_cpr)

    def f_orb():
        o = c.get("orb") or {}
        t = str(o.get("read") or "").upper()
        if o.get("status") != "OK" or not t or "FORMING" in t:
            return None, "data nahi"
        return (1 if "BREAKOUT" in t else -1 if "BREAKDOWN" in t else 0), t.title()
    B.safe(G, "Opening range", f_orb)

    def f_candle():
        cd = c.get("candle") or {}
        v = _lean(cd.get("bias"))
        if v is None:
            return None, "data nahi"
        return (v if _f(cd.get("strength")) and _f(cd.get("strength")) >= 0.5 else 0), str(cd.get("pattern") or "")[:30]
    B.safe(G, "Candle pattern", f_candle, w=0.7)

    # ------------------------------------------------------------- STRUCTURE & LEVELS
    G = "Structure & Levels"

    def f_smc():
        v = _lean(c.get("smc_event"))
        return (None, "data nahi") if v is None else (v, str(c.get("smc_event"))[:34])
    B.safe(G, "Market structure (BOS/CHoCH)", f_smc)

    mtf = c.get("mtf") or {}

    def f_htf():
        v = _lean(mtf.get("htf_bias"))
        return (None, "data nahi") if v is None else (v, f"HTF {mtf.get('htf_bias')}")
    B.safe(G, "Higher timeframes", f_htf, w=1.5)

    def f_ltf():
        v = _lean(mtf.get("ltf_bias"))
        return (None, "data nahi") if v is None else (v, f"LTF {mtf.get('ltf_bias')}")
    B.safe(G, "Lower timeframes", f_ltf)

    def f_sr():
        sr = c.get("sr_context") or {}
        loc = str(sr.get("location") or "")
        if not loc or loc in ("UNKNOWN",):
            return None, "data nahi"
        v = 1 if loc in ("AT_SUPPORT", "NEAR_SUPPORT") else -1 if loc in ("AT_RESISTANCE", "NEAR_RESISTANCE") else 0
        return v, loc.replace("_", " ").title()
    B.safe(G, "Support / Resistance location", f_sr)

    def f_level():
        lp = c.get("level_prediction") or {}
        if lp.get("status") != "APPROACHING_LEVEL":
            return None, "koi level paas nahi"
        v = _lean(lp.get("directional_bias"))
        return (None, "data nahi") if v is None else (v, f"break {lp.get('break_pct')}% / bounce {lp.get('bounce_pct')}%")
    B.safe(G, "Level break/bounce predictor", f_level, w=1.5)

    def f_regime():
        r = str((c.get("regime") or {}).get("primary") or "").upper()
        if not r:
            return None, "data nahi"
        return (1 if "BULL" in r else -1 if "BEAR" in r else 0), r.title()
    B.safe(G, "Market regime (ADX)", f_regime)

    # ------------------------------------------------------------- OPTIONS & OI
    G = "Options & OI"
    pcr = _f(c.get("current_pcr"))
    oc = c.get("oc")
    oc_live = bool(c.get("oc_live"))

    def f_pcr():
        if pcr is None or not oc_live:
            return None, "live option chain nahi"
        return (1 if pcr >= 1.2 else -1 if pcr <= 0.8 else 0), f"PCR {pcr:.2f}"
    B.safe(G, "PCR", f_pcr)

    def f_pcrv():
        pv = c.get("pcr_vel") or {}
        v = _lean(pv.get("bias"))
        if v is None or pv.get("per15") is None:
            return None, "history ban rahi hai"
        return v, str(pv.get("note") or "")[:40]
    B.safe(G, "PCR velocity", f_pcrv, w=0.8)

    def f_fii():
        t = str(c.get("fii_footprint") or "").upper()
        if not t or t in ("N/A", "NONE"):
            return None, "data nahi"
        return (1 if t.startswith("BULLISH") else -1 if t.startswith("BEARISH") else 0), str(c.get("fii_footprint"))[:30]
    B.safe(G, "FII option footprint", f_fii)

    def f_skew():
        s = c.get("iv_skew")
        sk = _f(s.get("skew")) if isinstance(s, dict) else None
        if sk is None:
            return None, "data nahi"
        return (1 if sk <= -1.5 else -1 if sk >= 4.0 else 0), f"IV skew {sk:+.1f}"
    B.safe(G, "IV skew", f_skew, w=0.6)

    def f_wall():
        if not oc_live or oc is None or getattr(oc, "empty", True) or px is None:
            return None, "live option chain nahi"
        below = oc[oc["Strike"] <= px]
        above = oc[oc["Strike"] >= px]
        if below.empty or above.empty:
            return None, "data nahi"
        sup = float(below.loc[below["Put OI"].idxmax(), "Strike"])
        res = float(above.loc[above["Call OI"].idxmax(), "Strike"])
        ds, dr = px - sup, res - px
        if ds <= 0 and dr <= 0:
            return 0, "OI walls overlap"
        v = 1 if (ds >= 0 and ds < dr * 0.6) else -1 if (dr >= 0 and dr < ds * 0.6) else 0
        return v, f"Put wall {sup:.0f} ({ds:.0f} niche) / Call wall {res:.0f} ({dr:.0f} upar)"
    B.safe(G, "OI walls (nearest)", f_wall, w=1.2)

    def f_pain():
        mp = _f(c.get("max_pain"))
        if mp is None or px is None or not oc_live:
            return None, "data nahi"
        d = (px - mp) / atr
        return (1 if d <= -0.5 else -1 if d >= 0.5 else 0), f"max pain {mp:.0f}"
    B.safe(G, "Max pain pull", f_pain, w=0.5)

    def f_vix():
        v = _f(c.get("live_vix"))
        if v is None:
            return None, "data nahi"
        return (-1 if v >= 20 else 1 if v < 14 else 0), f"India VIX {v:.1f}"
    B.safe(G, "India VIX", f_vix, w=0.6)

    # ------------------------------------------------------------- FLOW & BREADTH
    G = "Flow & Breadth"

    def f_of():
        of = c.get("order_flow") or {}
        t = str(of.get("pressure") or "").upper()
        if of.get("status") != "OK" or not t:
            return None, "futures depth nahi"
        return (1 if t.startswith("BUYING") else -1 if t.startswith("SELLING") else 0), f"imbalance {of.get('imbalance_pct')}%"
    B.safe(G, "Futures order book", f_of)

    def f_adv(adv, dec, label):
        a, d = _f(adv), _f(dec)
        if a is None or d is None or a + d <= 0:
            return None, "data nahi"
        r = (a - d) / (a + d)
        return (1 if r >= 0.2 else -1 if r <= -0.2 else 0), f"{int(a)} up / {int(d)} down"
    B.safe(G, "Heavyweight breadth", lambda: f_adv(c.get("adv"), c.get("dec"), "heavy"))
    B.safe(G, "Nifty-50 breadth", lambda: f_adv(c.get("adv50"), c.get("dec50"), "full"))

    def f_sector():
        sb = c.get("sector_breadth")
        if sb is None or len(sb) < 4:
            return None, "data nahi"
        ch = [x for x in (_f(v) for v in sb["Avg Change (%)"]) if x is not None]
        if len(ch) < 4:
            return None, "data nahi"
        up, dn = sum(v > 0.10 for v in ch), sum(v < -0.10 for v in ch)
        r = (up - dn) / len(ch)
        return (1 if r >= 0.4 else -1 if r <= -0.4 else 0), f"{up} sector up / {dn} down"
    B.safe(G, "Sector breadth", f_sector)

    def f_sensex():
        for r in c.get("index_corr") or []:
            if str(r.get("name")) == "Sensex":
                v = _sgn_pct(r.get("change_pct"), 0.15)
                return (None, "data nahi") if v is None else (v, f"Sensex {r.get('change_pct'):+.2f}%")
        return None, "data nahi"
    B.safe(G, "Sensex", f_sensex, w=0.7)

    # ------------------------------------------------------------- BANK (live)
    G = "Bank"
    bank_move = {}
    for sym in BANKS:
        ch = _bank_row_change(sym, c.get("df_full50"), c.get("df_heavy"))
        bank_move[sym] = ch
        v = _sgn_pct(ch, 0.15)
        B.add(G, BANK_NAME[sym], v, "data nahi" if ch is None else f"{ch:+.2f}%", 0.8)

    bn = next((r for r in (c.get("index_corr") or []) if str(r.get("name")) == "Bank Nifty"), None)
    bn_chg = _f((bn or {}).get("change_pct"))
    nifty_chg = _f(c.get("nifty_change_pct"))
    B.add(G, "Bank Nifty", _sgn_pct(bn_chg, 0.15), "data nahi" if bn_chg is None else f"{bn_chg:+.2f}%", 1.5)

    def f_bn_rel():
        if bn_chg is None or nifty_chg is None:
            return None, "data nahi"
        d = bn_chg - nifty_chg
        if abs(d) < 0.15:
            return 0, f"Bank Nifty Nifty ke saath ({d:+.2f}%)"
        return (1 if d > 0 else -1), f"Bank Nifty Nifty se {'aage' if d > 0 else 'peeche'} ({d:+.2f}%)"
    B.safe(G, "Bank Nifty vs Nifty", f_bn_rel)

    bank_fund = c.get("bank_fund") or {}

    def f_bank_fund():
        rows = [v for v in bank_fund.values() if v.get("label") in ("STRONG", "OK", "WEAK")]
        if len(rows) < 3:
            return None, "fundamentals load ho rahe hain / data nahi"
        strong = sum(v["label"] == "STRONG" for v in rows)
        weak = sum(v["label"] == "WEAK" for v in rows)
        net = strong - weak
        v = 1 if (net >= 2 or (net > 0 and strong >= len(rows) / 2)) else -1 if (net <= -2 or (net < 0 and weak >= len(rows) / 2)) else 0
        return v, f"{strong} strong / {weak} weak / {len(rows) - strong - weak} theek (of {len(rows)} banks)"
    B.safe(G, "Bank fundamentals", f_bank_fund, w=0.8)

    bank_news = c.get("bank_news") or {"label": "UNAVAILABLE"}
    B.add(G, "Bank news", _lean(bank_news.get("label")) if bank_news.get("label") != "UNAVAILABLE" else None,
          f"{bank_news.get('pos', 0)} +ve / {bank_news.get('neg', 0)} -ve", 0.8)

    # ------------------------------------------------------------- GLOBAL
    G = "Global"
    gm = c.get("df_global")

    def mk(name, needles, dead, invert=False, w=1.0, fmt="{:+.2f}%"):
        def _f1():
            v = _global_change(gm, *needles)
            if v is None:
                return None, "data nahi"
            s = _sgn_pct(v, dead)
            return (-s if invert else s), fmt.format(v)
        B.safe(G, name, _f1, w=w)
    mk("US markets", ("S&P 500", "Nasdaq", "Dow Jones"), 0.25, w=1.2)
    mk("Asia markets", ("Nikkei", "Hang Seng", "KOSPI", "Shanghai", "Straits"), 0.25)
    mk("Europe markets", ("FTSE", "DAX", "CAC"), 0.25, w=0.8)
    mk("Crude oil", ("Crude Oil",), 0.8, invert=True, w=0.6)
    mk("US Dollar (DXY)", ("Dollar Index",), 0.25, invert=True, w=0.6)
    mk("US 10Y yield", ("10-Year",), 1.0, invert=True, w=0.6)
    mk("USD/INR (rupee)", ("USD/INR",), 0.2, invert=True, w=0.6)

    def f_gres():
        gr = c.get("global_research") or {}
        if str(gr.get("status", "")).upper() != "AVAILABLE":
            return None, "data nahi"
        v = _lean(gr.get("directional_bias"))
        return (None, "data nahi") if v is None else (v, f"{gr.get('strength', '')} {gr.get('directional_bias', '')}".strip()[:36])
    B.safe(G, "Global research bias", f_gres, w=1.3)

    # ------------------------------------------------------------- NEWS
    G = "News"

    def f_india_news():
        gs = c.get("df_global_sent")
        if gs is None or getattr(gs, "empty", True):
            return None, "data nahi"
        row = gs[gs["Region / Country"].astype(str).str.contains("India", na=False)]
        if row.empty:
            return None, "data nahi"
        t = row.iloc[0]["Net Sentiment"]
        v = _lean(t)
        return (None, "data nahi") if v is None else (v, str(t)[:26])
    B.safe(G, "India market news", f_india_news)

    n50 = c.get("nifty_news") or {"label": "UNAVAILABLE"}
    B.add(G, "Nifty-50 headlines", _lean(n50.get("label")) if n50.get("label") != "UNAVAILABLE" else None,
          f"{n50.get('pos', 0)} +ve / {n50.get('neg', 0)} -ve of {n50.get('n', 0)}", 1.0)

    # ------------------------------------------------------------- FUNDAMENTALS
    G = "Fundamentals"

    def f_n50_fund():
        fb = c.get("n50_fund_bias")
        v = _lean(fb)
        return (None, "refresh nahi hua") if v is None else (v, f"Nifty-50 growth/ROE {fb}")
    B.safe(G, "Nifty-50 fundamentals", f_n50_fund)

    # ------------------------------------------------------------- MODELS
    G = "Models"

    def f_ai():
        ai = c.get("ai_analysis") or {}
        ns = _f(ai.get("net_score"))
        if ns is None:
            return None, "data nahi"
        return (1 if ns >= 0.22 else -1 if ns <= -0.22 else 0), f"AI net score {ns:+.2f}"
    B.safe(G, "AI confluence engine", f_ai, w=1.5)

    def f_strat():
        s = c.get("strategy_result") or {}
        b, se = int(s.get("buy_live_count") or 0), int(s.get("sell_live_count") or 0)
        if s.get("status") != "READY":
            return None, "data nahi"
        if b == se:
            return 0, f"strategies {b} BUY / {se} SELL"
        return (1 if b > se else -1), f"{b} strategy BUY / {se} SELL"
    B.safe(G, "Strategy engine (named setups)", f_strat, w=1.5)

    def f_ml():
        m = c.get("ml_results") or {}
        if not m.get("model_ready"):
            return None, "model ready nahi"
        sig = int(m.get("latest_signal") or 0)
        conf = _f(m.get("latest_confidence"))
        return (sig if sig in (-1, 1) else 0), (f"confidence {conf:.0f}%" if conf is not None else "")
    B.safe(G, "ML model (walk-forward)", f_ml)

    return _summarise(B.rows, c, bank_move, bank_fund, bank_news, n50, bn_chg, nifty_chg, px, atr)


# ----------------------------------------------------------------------------------------------------------------------------------
# summary
# ----------------------------------------------------------------------------------------------------------------------------------
def _tally(rows):
    b = sum(1 for r in rows if r["vote"] == 1)
    s = sum(1 for r in rows if r["vote"] == -1)
    n = sum(1 for r in rows if r["vote"] == 0)
    na = sum(1 for r in rows if r["vote"] is None)
    return b, s, n, na


def _group_edge(rows):
    num = den = 0.0
    for r in rows:
        if r["vote"] is None:
            continue
        num += r["w"] * r["vote"]
        den += r["w"]
    return (num / den) if den > 0 else None


_LBL = {"BULLISH": "Bullish", "BEARISH": "Bearish", "MIXED": "Mixed", "NEUTRAL": "Neutral", "NA": "data nahi", "UNAVAILABLE": "data nahi"}


def _strength(edge):
    a = abs(edge)
    return "STRONG" if a >= STRONG_EDGE else "MODERATE" if a >= MODERATE_EDGE else "WEAK" if a >= WEAK_EDGE else "BALANCED"


def _summarise(rows, c, bank_move, bank_fund, bank_news, n50, bn_chg, nifty_chg, px, atr):
    buy, sell, neu, na = _tally(rows)
    total = buy + sell + neu
    groups = {}
    for g in GROUP_ORDER:
        gr = [r for r in rows if r["group"] == g]
        if not gr:
            continue
        gb, gs, gn, gna = _tally(gr)
        groups[g] = {"buy": gb, "sell": gs, "neutral": gn, "na": gna, "edge": _group_edge(gr)}
    num = den = 0.0
    for g, v in groups.items():
        if v["edge"] is not None:
            num += GROUP_W[g] * v["edge"]
            den += GROUP_W[g]
    edge = (num / den) if den > 0 else 0.0
    strength = _strength(edge) if total >= 8 else "BALANCED"
    side = "BUY" if (edge > 0 and strength != "BALANCED") else "SELL" if (edge < 0 and strength != "BALANCED") else "BALANCED"
    coverage = round(100.0 * total / max(1, len(rows)))

    # strongest / weakest group for the side
    ranked = sorted([(g, v) for g, v in groups.items() if v["edge"] is not None], key=lambda kv: kv[1]["edge"])
    top_buy = ranked[-1] if ranked and ranked[-1][1]["edge"] > 0.2 else None
    top_sell = ranked[0] if ranked and ranked[0][1]["edge"] < -0.2 else None

    # ---- bank block
    bank_rows = [r for r in rows if r["group"] == "Bank"]
    bb, bs, bn_, bna = _tally(bank_rows)
    bank_edge = _group_edge(bank_rows)
    bank_label = "NA" if bank_edge is None else "BULLISH" if bank_edge >= 0.2 else "BEARISH" if bank_edge <= -0.2 else "MIXED"
    fr = next((r for r in rows if r["name"] == "Bank fundamentals"), None)
    if fr is None or fr["vote"] is None:
        fund_txt = "fundamentals load ho rahe hain"
        fund_vote = None
    else:
        fund_vote = fr["vote"]
        fund_txt = ("mazboot -> peeche se BUYING support" if fund_vote > 0 else "kamzor -> peeche se SELLING pressure" if fund_vote < 0
                    else "theek-thaak -> koi side nahi")
    bank_lines = []
    for sym in BANKS:
        ch = bank_move.get(sym)
        fd = (bank_fund or {}).get(sym) or {}
        bank_lines.append({"bank": BANK_NAME[sym], "change": ch, "fund": fd.get("label", "NA"), "notes": ", ".join(fd.get("notes") or [])})
    laggard = min((b for b in bank_lines if b["change"] is not None), key=lambda b: b["change"], default=None)
    leader = max((b for b in bank_lines if b["change"] is not None), key=lambda b: b["change"], default=None)

    # ---- lines
    icon = {"BUY": "🟢", "SELL": "🔴", "BALANCED": "🟡"}[side]
    line1 = f"🔴 SELL (neeche) **{sell}**  ·  🟢 BUY (upar) **{buy}**  ·  ⚪ NEUTRAL **{neu}**   (kul {total} factor, data coverage {coverage}%)"
    nl = n50.get("label", "UNAVAILABLE")
    news_txt = {"BULLISH": "🟢 Bullish", "BEARISH": "🔴 Bearish", "NEUTRAL": "⚪ Neutral", "UNAVAILABLE": "⚫ data nahi"}[nl]
    if nl != "UNAVAILABLE":
        news_txt += f" ({n50.get('pos', 0)}+ / {n50.get('neg', 0)}-)"
    head = n50.get("headline") or ""
    if head:
        news_txt += f" — “{head[:70]}{'…' if len(head) > 70 else ''}”"
    bank_txt = {"BULLISH": "🟢 Bullish", "BEARISH": "🔴 Bearish", "MIXED": "🟡 Mixed", "NA": "⚫ data nahi"}[bank_label]
    bank_txt += f" ({bb} BUY / {bs} SELL / {bn_} neutral)"
    if bn_chg is not None:
        bank_txt += f", BankNifty {bn_chg:+.2f}%"
    bank_txt += f", fundamentals {fund_txt}"
    line2 = f"📰 News: {news_txt}\n\n🏦 Bank: {bank_txt}"
    if side == "BALANCED":
        line3 = f"⚖️ Abhi koi side clear powerful nahi (edge {edge*100:+.0f}%) — jaldi mat karo, wait karo."
    else:
        word = "BUY" if side == "BUY" else "SELL"
        grp = top_buy if side == "BUY" else top_sell
        gtxt = f" · sabse strong group: {grp[0]} ({grp[1]['buy'] if side == 'BUY' else grp[1]['sell']}/{grp[1]['buy'] + grp[1]['sell'] + grp[1]['neutral']})" if grp else ""
        line3 = f"{icon} Abhi **{word}** side zyada powerful — **{strength}** (edge {abs(edge)*100:.0f}%){gtxt}"
    one_line = (f"🧮 Consensus: 🟢 BUY {buy} · 🔴 SELL {sell} · ⚪ NEUTRAL {neu}  →  "
                + ("⚖️ BALANCED (koi side clear nahi)" if side == "BALANCED" else f"{icon} {side} {strength}")
                + f"  |  🏦 Bank {_LBL[bank_label]}  |  📰 News {_LBL[nl]}")
    summary_text = "\n".join([line1, line2.replace("\n\n", "\n"), line3])

    return {
        "ok": True, "factors": rows, "buy": buy, "sell": sell, "neutral": neu, "na": na, "total": total, "coverage": coverage,
        "groups": groups, "edge": round(edge, 3), "side": side, "strength": strength,
        "bank": {"label": bank_label, "buy": bb, "sell": bs, "neutral": bn_, "na": bna, "edge": bank_edge, "fund_vote": fund_vote, "fund_text": fund_txt,
                 "rows": bank_lines, "leader": leader, "laggard": laggard, "bank_nifty_change": bn_chg, "nifty_change": nifty_chg,
                 "news": bank_news},
        "news": n50, "line1": line1, "line2": line2, "line3": line3, "one_line": one_line, "summary_text": summary_text,
        "price": px, "atr": atr, "ts": time.time(),
    }


# ----------------------------------------------------------------------------------------------------------------------------------
# session history: trend of the counts + honest in-session track record
# ----------------------------------------------------------------------------------------------------------------------------------
HIST_MAX = 500


def record(store, res, min_gap=60.0, now=None):
    """store: a plain list (kept in st.session_state).  One entry per >= min_gap seconds."""
    try:
        if not res or not res.get("ok"):
            return
        t = time.time() if now is None else float(now)
        if store and t - store[-1]["ts"] < min_gap:
            return
        store.append({"ts": t, "price": res.get("price"), "atr": res.get("atr"), "edge": res.get("edge"), "side": res.get("side"),
                      "strength": res.get("strength"), "buy": res.get("buy"), "sell": res.get("sell"), "neutral": res.get("neutral")})
        if len(store) > HIST_MAX:
            del store[: len(store) - HIST_MAX]
    except Exception:
        logger.debug("consensus record failed", exc_info=True)


def trend_note(store, res, minutes=10, now=None):
    """'10 min pehle BUY 12 / SELL 15 -> ab BUY 18 / SELL 11' (None if there is no old enough entry)."""
    try:
        t = time.time() if now is None else float(now)
        old = [e for e in (store or []) if t - e["ts"] >= minutes * 60 - 45]
        if not old or not res or not res.get("ok"):
            return None
        e = old[-1]
        if t - e["ts"] > 3 * 3600:
            return None
        mins = int(round((t - e["ts"]) / 60.0))
        db, ds = res["buy"] - e["buy"], res["sell"] - e["sell"]
        arrow = "BUY side badh rahi hai" if db - ds >= 2 else "SELL side badh rahi hai" if ds - db >= 2 else "lagbhag same"
        return f"{mins} min pehle: BUY {e['buy']} / SELL {e['sell']} / NEUTRAL {e['neutral']}  →  ab: BUY {res['buy']} / SELL {res['sell']} / NEUTRAL {res['neutral']}  ({arrow})"
    except Exception:
        return None


def track_record(store, horizon_min=15, min_edge=MODERATE_EDGE):
    """Did a MODERATE/STRONG reading agree with where price was ~15 min later?  Session-only, small sample -- shown with its n."""
    try:
        h = horizon_min * 60.0
        n = hits = 0
        for i, e in enumerate(store or []):
            if e.get("edge") is None or abs(e["edge"]) < min_edge or e.get("price") is None:
                continue
            later = next((x for x in store[i + 1:] if x["ts"] - e["ts"] >= h and x["ts"] - e["ts"] <= h + 600 and x.get("price") is not None), None)
            if later is None:
                continue
            move = later["price"] - e["price"]
            if abs(move) < 0.1 * (e.get("atr") or 15.0):
                continue                                    # flat -> neither right nor wrong
            n += 1
            hits += 1 if (move > 0) == (e["edge"] > 0) else 0
        return {"n": n, "hits": hits, "pct": (100.0 * hits / n) if n else None}
    except Exception:
        return {"n": 0, "hits": 0, "pct": None}


# ----------------------------------------------------------------------------------------------------------------------------------
# streamlit rendering (st is passed in so this module stays import-light)
# ----------------------------------------------------------------------------------------------------------------------------------
def _names(rows, vote, limit=40):
    out = [f"{r['name']}" + (f" ({r['detail']})" if r["detail"] and r["detail"] != "data nahi" else "") for r in rows if r["vote"] == vote]
    return out[:limit]


def render(st, res, hist=None):
    """One always-visible line + one constant-label expander (constant label => it keeps its open/closed state across the 30 s refresh)."""
    if not res:
        return
    if not res.get("ok"):
        st.caption(res.get("one_line", ""))
        return
    side = res["side"]
    box = st.success if side == "BUY" else st.error if side == "SELL" else st.info
    box(res["one_line"])
    with st.expander("🧮 Consensus Engine — poora detail (kaun-kaun se factor BUY / SELL / NEUTRAL)", expanded=False):
        st.markdown(res["line1"])
        st.markdown(res["line2"])
        st.markdown(res["line3"])
        tn = trend_note(hist, res) if hist is not None else None
        if tn:
            st.caption("⏱️ " + tn)
        st.markdown("**Group-wise (kaun sa hissa kis taraf):**")
        rows = []
        for g, v in res["groups"].items():
            e = v["edge"]
            lean = "—" if e is None else ("🟢 BUY" if e >= 0.2 else "🔴 SELL" if e <= -0.2 else "⚪ mixed")
            rows.append({"Group": g, "BUY": v["buy"], "SELL": v["sell"], "NEUTRAL": v["neutral"], "Lean": lean})
        try:
            import pandas as _pd
            st.dataframe(_pd.DataFrame(rows), hide_index=True, width="stretch")
        except Exception:
            for r in rows:
                st.write(r)
        c1, c2 = st.columns(2)
        with c1:
            st.markdown("**Agar abhi BUY lo to**")
            st.markdown(f"✅ Saath ({res['buy']}): " + (" · ".join(_names(res['factors'], 1)) or "—"))
            st.markdown(f"❌ Khilaf ({res['sell']}): " + (" · ".join(_names(res['factors'], -1)) or "—"))
        with c2:
            st.markdown("**Agar abhi SELL lo to**")
            st.markdown(f"✅ Saath ({res['sell']}): " + (" · ".join(_names(res['factors'], -1)) or "—"))
            st.markdown(f"❌ Khilaf ({res['buy']}): " + (" · ".join(_names(res['factors'], 1)) or "—"))
        st.markdown(f"⚪ Neutral ({res['neutral']}): " + (" · ".join(_names(res['factors'], 0)) or "—"))
        nas = [r["name"] for r in res["factors"] if r["vote"] is None]
        if nas:
            st.caption("⚫ Data nahi aaya (count mein nahi gine): " + ", ".join(nas))
        bk = res["bank"]
        st.markdown("**🏦 Bank detail**")
        try:
            import pandas as _pd
            st.dataframe(_pd.DataFrame([{"Bank": b["bank"], "Aaj": "—" if b["change"] is None else f"{b['change']:+.2f}%",
                                          "Fundamentals": b["fund"], "Kyun": b["notes"]} for b in bk["rows"]]), hide_index=True, width="stretch")
        except Exception:
            pass
        if bk.get("news", {}).get("headlines"):
            st.caption("Bank news: " + " | ".join(h[:80] for h in bk["news"]["headlines"][:3]))
        if res["news"].get("headlines"):
            st.caption("Nifty news: " + " | ".join(h[:80] for h in res["news"]["headlines"][:3]))
        tr = track_record(hist) if hist is not None else None
        if tr and tr["n"] >= 5:
            st.caption(f"📈 Is session mein MODERATE/STRONG reading 15 min baad {tr['hits']}/{tr['n']} baar sahi rahi ({tr['pct']:.0f}%) — chhota sample, bharose se mat lo.")
        elif tr is not None:
            st.caption(f"📈 Track record abhi ban raha hai ({tr['n']} reading check hui) — 5+ ke baad % dikhega.")
        st.caption("Ye data ka reading hai (kitne factor kis taraf) — future ki guarantee nahi. Winner raw count se nahi, group-balanced edge se chuna jata hai "
                   "taaki RSI/MACD/EMA jaise ek hi baat bolne wale factor baaki sabko dabaa na dein.")
# @@END consensus_engine
