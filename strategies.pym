# strategies.pym -- module bundle: Strategy library, entry quality, edge model, ML / neural learner, backtests, hybrid AI engine
# Each section between '# @@MODULE name' and '# @@END name' is the ORIGINAL module source, unchanged.
# bundle_loader.py imports every section as its own module (same import names as before).
# Modules in this bundle: strategy_engine, entry_quality, edge_model, learner_nn, ml_engine, backtest_engine, historical_backtest, hybrid_ai_engine
# @@MODULE strategy_engine
"""Named strategy library + adaptive ensemble for the NIFTY intraday engine.

The strategy layer is intentionally independent from the existing AI/self-learning
research engine.  A strategy can produce an entry candidate, but the final trade
requires the AI research direction to agree with that strategy direction.

The module uses only completed bars for signals and chronological walk-forward
validation.  It does not claim that a backtest guarantees future performance.
"""
from __future__ import annotations

import math
import threading
from concurrent.futures import ThreadPoolExecutor
from typing import Any, Dict, List, Optional, Tuple

import numpy as np
import pandas as pd

STRATEGY_VERSION = "v3_35_live_direction_consensus"
# Walk-forward stats use the same risk convention as the live engine so the
# displayed strategy statistics are not based on a different hidden R:R model.
WF_SL_POINTS = 20.0
WF_RR = 1.5
DEFAULT_HORIZON = 12
MIN_WF_SAMPLES = 20
MIN_WF_RESOLVED_FOR_RATE = 10
VERIFIED_WF_SAMPLES = 30
# ENTRY GATES (single source of truth -- ai_trade_decision imports these).
# An untested strategy sits at a 50 raw baseline -> ~34 + regime-fit bonus (~7) = ~41.
# Proven-good strategies rise above that, proven-bad ones fall below it. The old gate
# (58) was mathematically unreachable for almost every strategy (best live score in the
# dashboard was 42), which is why the engine never produced a single trade.
MIN_ENTRY_SCORE = 38.0
MIN_EDGE = 3.0   # when BUY and SELL strategies fire together, the winner must lead by this much
RECENT_SETUP_BARS = 6  # a short execution window; prevents a valid setup disappearing between refreshes

# Performance cache: the 30-second Streamlit refresh used to recompute the full
# chronological walk-forward for every named strategy. That is the main reason
# the Strategy Library could take a long time and make the sections below appear
# stuck loading. Walk-forward depends only on the completed price history, so it
# is cached by a lightweight data fingerprint and refreshed when the candle set
# changes.
_WF_CACHE = {}
_WF_FUTURES = {}
_WF_LOCK = threading.Lock()
_WF_EXECUTOR = ThreadPoolExecutor(max_workers=1, thread_name_prefix="strategy-wf")
# REFRESH-LAG FIX: the cache key used to contain the LIVE (still forming) candle, so it changed on
# every 30 s refresh -> 40 new walk-forward jobs were queued each time, none ever finished, the
# CPU stayed busy and the dashboard seemed to refresh non-stop.  Now: one job per strategy, result
# kept for WF_REFRESH_SECONDS (stale-while-revalidate), and per-bar signals of COMPLETED candles cached.
WF_REFRESH_SECONDS = 900
_WF_LAST = {}      # strategy -> (finished_ts, result)
_WF_PENDING = {}   # strategy -> future
_BAR_SIG = {}      # (strategy, first_ts, bar_ts) -> signal of a completed bar
_BAR_SIG_MAX = 6000
_WF_CACHE_MAX = 128
_SIGNAL_CACHE = {}
_SIGNAL_CACHE_MAX = 256

